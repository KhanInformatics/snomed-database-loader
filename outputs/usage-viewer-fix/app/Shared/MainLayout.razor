        }
    };
    
    // Toggle sidebar visibility
    public void ToggleSidebar()
    {
        SidebarToggle = !SidebarToggle;
    }

    public class MenuItemData
    {
        public string Text { get; set; } = string.Empty;
        public string? Url { get; set; }
        public string? IconCss { get; set; }
        public List<MenuItemData>? Items { get; set; }
    }
}

<style>    /* Sample specific styles*/
    .container-fluid {
        padding-left: 0;
        padding-right: 0;
    }
    
    /* Menu header styles */
    .menu-header {
        padding: 10px;
        background-color: #f8f9fa;
        border-bottom: 1px solid #dee2e6;
        margin-bottom: 10px;
    }
    
    .header-content {
        display: flex;
        align-items: center;
        gap: 10px;
    }
    
    .hamburger-btn {
        background: none;
        border: none;
        font-size: 18px;
        cursor: pointer;
        padding: 5px;
        border-radius: 3px;
        color: #333;
    }
    
    .hamburger-btn:hover {
        background-color: #e9ecef;
    }
    
    .app-title {
        font-weight: 500;
        font-size: 14px;
        color: #333;
    }
    
    /* Hide title when sidebar is docked */
    .sidebar-menu.e-dock.e-close .menu-header .app-title {
        display: none;
    }
    #wrapper .icon-menu {
        font-size: 24px;
    }
    @@media(max-width:500px) {
        #wrapper #maintext.main-content {
            height: 100vh;
        }
    }
    #wrapper .sidebar-menu {
        z-index: 20 !important;
    }
    /* Specific styles for Menu container element*/
    #wrapper .dock-menu.e-menu-container {
        border: 0px;
    }
    .e-bigger .e-folder {
        font-size: 18px;
    }
    .e-folder {
        text-align: center;
        font-weight: 500;
        font-size: 16px
    }
    /* Specific styles for Right side pane elements*/
    #maintext.main-content {
        min-height: 100vh;
    }
    #wrapper .sidebar-menu .e-menu-container {
        border: 0px;
        min-height: 100vh;
    }
    #maintext .content {
        padding: 15px;
    }    /* Specific styles for Menu component */
    .sidebar-menu .e-menu-container ul .e-menu-item.e-menu-caret-icon {
        width: 220px;
    }
    .e-close .e-menu-container ul .e-menu-item {
        width: 50px;
    }
    .e-close ul .e-menu-item.e-menu-caret-icon {
        padding-right: 12px;
    }
    .sidebar-menu.e-dock.e-close .e-menu-container ul .e-menu-item .e-caret {
        display: none;
    }
    .sidebar-menu.e-dock.e-close .e-menu-container ul .e-menu-item.e-menu-caret-icon,
    .sidebar-menu.e-dock.e-close .e-menu-container ul.e-vertical {
        min-width: 0;
        width: 50px !important;
    }
    .sidebar-menu.e-dock.e-close .e-menu-container ul.e-menu {
        font-size: 0;
    }
    .sidebar-menu.e-dock.e-close .e-menu-item .e-menu-icon {
        font-size: 20px;
        padding: 0;
    }
    .sidebar-menu, .e-menu-wrapper, .e-menu-container ul {
        overflow: hidden;
    }

    /* Font Awesome icons in Syncfusion Menu */
    .e-menu-item .e-menu-icon.fas,
    .e-menu-item .e-menu-icon.far,
    .e-menu-item .e-menu-icon.fab {
        font-family: "Font Awesome 6 Free", "Font Awesome 6 Brands" !important;
        font-weight: 900;
        font-size: 16px;
        width: 16px;
        height: 16px;
        display: inline-block;
        margin-right: 8px;
    }

    .e-menu-item .e-menu-icon.far {
        font-weight: 400;
    }

    /* Ensure Font Awesome CSS is properly applied */
    .fas, .far, .fab {
        font-family: "Font Awesome 6 Free", "Font Awesome 6 Brands";
        font-style: normal;
        font-variant: normal;
        text-rendering: auto;
        line-height: 1;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
    }

    #wrapper .icon-menu:before {
        content: '\e914';
        font-family: 'e-icons'
    }
    
</style>