                    Text = "Term Browser",
                    IconCss = "fas fa-sitemap",
                    Url = "/readv2-browser"
                },
                new MenuItemData {
                    Text = "Search",
                    IconCss = "fas fa-search",
                    Url = "/readv2-search"
                }
            }
        },
        new MenuItemData {
            Text = "SNOMED",
            IconCss = "fas fa-stethoscope",
            Items = new List<MenuItemData> {
                new MenuItemData {
                    Text = "Primary Care Usage Viewer",
                    IconCss = "fas fa-chart-bar",
                    Url = "/usage-viewer-syncfusion"
                },
                new MenuItemData {
                    Text = "PCD Cluster Search",
                    IconCss = "fas fa-list",
                    Url = "/cluster-search"
                },
                new MenuItemData {
                    Text = "ECL Query",
                    IconCss = "fas fa-code",
                    Url = "/ecl-query"
                },
                new MenuItemData {
                    Text = "Search",
                    IconCss = "fas fa-search",
                    Url = "/search"
                },
                new MenuItemData {
                    Text = "Read Code Search",
                    IconCss = "fas fa-link",
