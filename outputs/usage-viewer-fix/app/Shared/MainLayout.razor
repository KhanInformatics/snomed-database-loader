@inherits LayoutComponentBase

<div id="control-section">
    <div id="wrapper">        @*Initialize the Sidebar component*@
        <SfSidebar class="sidebar-menu" Target=".main-content" Width="220px" DockSize="50px" EnableDock="true" @bind-IsOpen="SidebarToggle" Type="@SidebarType.Auto">
            <ChildContent>
                <div class="main-menu">
                    <div class="menu-header">
                        <div class="header-content">
                            <button class="hamburger-btn" @onclick="ToggleSidebar">
                                <i class="fas fa-bars"></i>
                            </button>
                            <span class="app-title">KhanClinicalInformatics.net</span>
                        </div>
                    </div>
                    <div>
                        <SfMenu CssClass="dock-menu" Items="@MainMenuItems" Orientation="@VerOrientation">
                            <MenuFieldSettings Text="Text" Url="Url" IconCss="IconCss"></MenuFieldSettings>
                        </SfMenu>
                    </div>
                </div>
            </ChildContent>
        </SfSidebar>
        @*main content declaration*@
        <div class="main-content" id="maintext">
            <div class="content">
                @Body
            </div>
        </div>
    </div>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    // Specifies the orientation type of Menu component.
    public Syncfusion.Blazor.Navigations.Orientation VerOrientation = Syncfusion.Blazor.Navigations.Orientation.Vertical;
    // Specify the value of Sidebar component state. It indicates whether the sidebar component is in an open/close state.
    public bool SidebarToggle = false;    // Specifies the value of Menu component Datasource property.
    public List<MenuItemData> MainMenuItems = new List<MenuItemData>{
        new MenuItemData {
