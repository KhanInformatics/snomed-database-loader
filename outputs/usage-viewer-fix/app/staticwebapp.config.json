{
  "routes": [
    {
      "route": "/data/snomed-usage/manifest.json",
      "headers": {
        "cache-control": "no-cache"
      }
    },
    {
      "route": "/data/snomed-usage/*",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      }
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/images/*.{png,jpg,gif}", "/css/*", "/js/*", "/_framework/*", "/data/*"]
  }
}
