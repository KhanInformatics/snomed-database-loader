@page "/contact"

<PageTitle>Contact Us - Dr Imran Khan</PageTitle>

<!-- Page Header Section - positioned to align with sidebar -->
<div class="page-header-wrapper">
    <div class="page-header">
        <div class="page-header-content">
            <div class="page-header-main">
                <h4 class="page-title mb-1">Contact Us</h4>
                <p class="page-subtitle mb-0">Get in touch with Dr Imran Khan for clinical informatics and healthcare technology inquiries</p>
            </div>
            <div class="page-header-actions">
                <a href="mailto:imran@khanclinicalinformatics.net" class="btn btn-sm btn-primary">
                    <i class="fas fa-envelope me-1"></i>Send Email
                </a>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid" style="margin-top: 0; padding-top: 1rem;">
    <div class="content-section">
        <!-- Contact Information Section -->
        <div class="row mb-4">
            <div class="col-lg-8">
                <div class="card h-100">
                    <div class="card-body">
                        <h5 class="card-title">
                            <i class="fas fa-address-card text-primary me-2"></i>
                            Contact Information
                        </h5>
                        <div class="contact-details">
                            <div class="contact-item mb-3">
                                <div class="d-flex align-items-center">
                                    <i class="fas fa-envelope text-primary me-3 fa-lg"></i>
                                    <div>
                                        <h6 class="mb-1">Email</h6>
                                        <a href="mailto:imran@khanclinicalinformatics.net" class="text-decoration-none">
                                            imran@khanclinicalinformatics.net
                                        </a>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="contact-item mb-3">
                                <div class="d-flex align-items-center">
                                    <i class="fas fa-globe text-primary me-3 fa-lg"></i>
                                    <div>
                                        <h6 class="mb-1">Website</h6>
                                        <a href="https://khanclinicalinformatics.net/" target="_blank" class="text-decoration-none">
                                            khanclinicalinformatics.net
                                        </a>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="contact-item mb-3">
                                <div class="d-flex align-items-center">
                                    <i class="fab fa-linkedin text-primary me-3 fa-lg"></i>
                                    <div>
                                        <h6 class="mb-1">LinkedIn</h6>
                                        <a href="https://www.linkedin.com/in/imran-khan-6342bb167/" target="_blank" class="text-decoration-none">
                                            LinkedIn Profile
                                        </a>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="contact-item mb-3">
                                <div class="d-flex align-items-center">
                                    <i class="fab fa-github text-primary me-3 fa-lg"></i>
                                    <div>
                                        <h6 class="mb-1">GitHub</h6>
                                        <a href="https://github.com/KhanInformatics" target="_blank" class="text-decoration-none">
                                            KhanInformatics
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="col-lg-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h5 class="card-title">
                            <i class="fas fa-info-circle text-primary me-2"></i>
                            Professional Services
                        </h5>
                        <p class="card-text">Dr Imran Khan provides expertise in:</p>
                        <ul class="list-unstyled">
                            <li><i class="fas fa-check text-success me-2"></i>Clinical Informatics</li>
                            <li><i class="fas fa-check text-success me-2"></i>Clinical Safety (DCB0129/DCB0160)</li>
                            <li><i class="fas fa-check text-success me-2"></i>Healthcare IT Systems</li>
                            <li><i class="fas fa-check text-success me-2"></i>Primary Care Digital Solutions</li>
                            <li><i class="fas fa-check text-success me-2"></i>Information Governance</li>
                            <li><i class="fas fa-check text-success me-2"></i>Clinical Safety Officer Services</li>
                            <li><i class="fas fa-check text-success me-2"></i>Digital Health Transformation Leadership</li>
                        </ul>
                        
                        <div class="mt-3">
                            <a href="https://khaninformatics.github.io/ResumeMark/docs/assets/DrImranKhanCV.pdf" target="_blank" class="btn btn-outline-primary btn-sm">
                                <i class="fas fa-file-pdf me-1"></i>Download CV
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Contact Form Section -->
        <div class="row mb-4">
            <div class="col-12">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">
                            <i class="fas fa-paper-plane text-primary me-2"></i>
                            Send a Message
                        </h5>
                        <p class="text-muted mb-4">
                            For inquiries about clinical informatics services, clinical safety consultancy, or collaboration opportunities, 
                            please use the email link below or contact directly via the provided email address.
                        </p>
                        
                        <div class="row">
                            <div class="col-md-6">
                                <div class="email-template-info">
                                    <h6 class="fw-bold mb-3">Quick Contact Options:</h6>
                                    <div class="d-grid gap-2">
                                        <a href="mailto:imran@khanclinicalinformatics.net?subject=Clinical%20Informatics%20Inquiry" 
                                           class="btn btn-primary">
                                            <i class="fas fa-stethoscope me-2"></i>Clinical Informatics Inquiry
                                        </a>
                                        <a href="mailto:imran@khanclinicalinformatics.net?subject=Clinical%20Safety%20Services" 
                                           class="btn btn-outline-primary">
                                            <i class="fas fa-shield-alt me-2"></i>Clinical Safety Services
                                        </a>
                                        <a href="mailto:imran@khanclinicalinformatics.net?subject=General%20Inquiry" 
                                           class="btn btn-outline-secondary">
                                            <i class="fas fa-envelope me-2"></i>General Inquiry
                                        </a>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="contact-note">
                                    <div class="alert alert-info">
                                        <i class="fas fa-lightbulb me-2"></i>
                                        <strong>Response Time:</strong> I will typically respond to inquiries within 24-48 hours.
                                    </div>
                                    <div class="alert alert-success">
                                        <i class="fas fa-phone me-2"></i>
                                        <strong>Urgent Matters:</strong> For urgent matters, please indicate "URGENT" in your email subject line.
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Professional Affiliations -->
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">
                            <i class="fas fa-building text-primary me-2"></i>
                            Professional Affiliations
                        </h5>
                        <div class="row text-center">
                            <div class="col-md-3 mb-3">
                                <div class="affiliation-item">
                                    <i class="fas fa-hospital text-primary fa-2x mb-2"></i>
                                    <h6>NHS GP</h6>
                                    <p class="small text-muted">On GMC GP Register</p>
                                </div>
                            </div>
                            <div class="col-md-3 mb-3">
                                <div class="affiliation-item">
                                    <i class="fas fa-users text-primary fa-2x mb-2"></i>
                                    <h6>RCGP</h6>
                                    <p class="small text-muted">Health Informatics Group Chair</p>
                                </div>
                            </div>
                            <div class="col-md-3 mb-3">
                                <div class="affiliation-item">
                                    <i class="fas fa-shield-alt text-primary fa-2x mb-2"></i>
                                    <h6>Clinical Safety Officer</h6>
                                    <p class="small text-muted">DCB0129/DCB0160 trained </p>
                                </div>
                            </div>
                            <div class="col-md-3 mb-3">
                                <div class="affiliation-item">
                                    <i class="fas fa-laptop-code text-primary fa-2x mb-2"></i>
                                    <h6>BCS</h6>
                                    <p class="small text-muted">Member of the British Computer Society</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* Page header styling to match the application design */
    .page-header-wrapper {
        padding: 0;
        margin: 0;
        border-bottom: 1px solid #dee2e6;
        background-color: #f8f9fa;
    }

    .page-header {
        padding: 15px;
        background-color: #f8f9fa;
        border-bottom: 1px solid #dee2e6;
        height: 42px !important;
        min-height: 42px !important;
        max-height: 42px !important;
        box-sizing: border-box;
        display: flex;
        align-items: center;
        max-width: 100%;
        margin: 0;
    }

    .page-header-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
        width: 100%;
        flex-wrap: nowrap;
    }

    .page-header-main {
        flex-grow: 1;
        min-width: 0;
        margin-right: 20px;
    }

    .page-title {
        font-size: 1.1rem;
        font-weight: 500;
        color: #333;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        margin: 0;
        line-height: 1.1;
    }

    .page-subtitle {
        font-size: 0.75rem;
        color: #6c757d;
        margin: 0;
        line-height: 1.1;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .page-header-actions {
        display: flex;
        align-items: center;
        gap: 15px;
        flex-shrink: 0;
        margin-left: auto;
        justify-content: flex-end;
        min-width: fit-content;
    }

    /* Contact page specific styles */
    .contact-item {
        padding: 1rem 0;
        border-bottom: 1px solid #f0f0f0;
    }

    .contact-item:last-child {
        border-bottom: none;
    }

    .contact-item h6 {
        font-weight: 600;
        color: #333;
    }

    .contact-item a {
        color: #007bff;
        font-weight: 500;
    }

    .contact-item a:hover {
        color: #0056b3;
        text-decoration: underline !important;
    }

    .email-template-info .btn {
        text-align: left;
        border-radius: 6px;
        padding: 0.75rem 1rem;
        font-weight: 500;
    }

    .affiliation-item {
        padding: 1rem;
        border-radius: 8px;
        background-color: #f8f9fa;
        height: 100%;
        transition: transform 0.2s ease-in-out;
    }

    .affiliation-item:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 8px rgba(0,0,0,0.1);
    }

    .affiliation-item h6 {
        font-weight: 600;
        color: #333;
        margin-bottom: 0.5rem;
    }

    .contact-note .alert {
        border-radius: 8px;
        margin-bottom: 1rem;
    }    /* Responsive design */
    @@media (max-width: 768px) {
        .page-header-content {
            flex-direction: column;
            align-items: flex-start;
        }
        
        .page-header-actions {
            margin-top: 10px;
            width: 100%;
            justify-content: flex-start;
            margin-left: 0;
        }
        
        .page-title {
            font-size: 1rem !important;
        }
        
        .page-subtitle {
            font-size: 0.7rem !important;
        }
        
        .page-header-main {
            margin-right: 0;
        }

        .contact-item {
            padding: 0.75rem 0;
        }

        .email-template-info .btn {
            margin-bottom: 0.5rem;
        }
    }
</style>
