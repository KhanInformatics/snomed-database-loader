        align-items: center;
        max-width: 100%;
        margin: 0;
    }

    .page-header-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
        width: 100%;
        flex-wrap: nowrap;
    }

    .page-header-main {
        flex-grow: 1;
        min-width: 0;
        margin-right: 20px;
    }

    .page-title {
        font-size: 1.1rem;
        font-weight: 500;
        color: #333;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        margin: 0;
        line-height: 1.1;
    }

    .page-subtitle {
        font-size: 0.75rem;
        color: #6c757d;
        margin: 0;
        line-height: 1.1;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .page-header-actions {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-shrink: 0;
    }

    .version-pill {
        display: inline-flex;
        flex-direction: column;
        background: white;
        color: #4a5568;
        padding: 4px 10px;
        border-radius: 6px;
        border: 1.5px solid #5b7fda;
