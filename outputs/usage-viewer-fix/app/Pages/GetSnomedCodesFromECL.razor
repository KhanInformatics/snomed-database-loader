    }

    .info-panel-header {
        display: flex;
        align-items: center;
        margin-bottom: 12px;
        font-size: 0.95rem;
        color: #2c5aa0;
        font-weight: 600;
    }

    .info-panel-content {
        font-size: 0.85rem;
