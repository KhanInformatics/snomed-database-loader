@page "/snomed-hierarchy-complex"
@using Syncfusion.Blazor.Inputs
@using Syncfusion.Blazor.Diagram
@using Syncfusion.Blazor.Buttons
@using ButtonChangeArgs = Syncfusion.Blazor.Buttons.ChangeEventArgs<bool>

<PageTitle>SNOMED CT Complex Hierarchy</PageTitle>

<!-- Page Header Section -->
<div class="page-header-wrapper">
    <div class="page-header">
        <div class="page-header-content">
            <div class="page-header-main">
                <h4 class="page-title mb-1">SNOMED CT Complex Hierarchy: Pneumonia (233604007)</h4>
                <p class="page-subtitle mb-0">ComplexHierarchicalTree layout optimized for polyhierarchy visualization</p>
            </div>
            <div class="page-header-actions">
                <span class="badge bg-primary me-2">28 Ancestors</span>
                <span class="badge bg-success me-2">Multiple Parents Supported</span>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid" style="margin-top: 0; padding-top: 1rem;">
    <!-- Controls -->
    <div class="row mb-3">
        <div class="col-md-8">
            <div class="card" style="box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
                <div class="card-body py-2">
                    <div class="d-flex flex-wrap gap-4 align-items-center">
                        <div class="d-flex align-items-center">
                            <label class="form-label small mb-0 me-2">Orientation:</label>
                            <div class="btn-group btn-group-sm">
                                <button class="btn @(OrientationType == LayoutOrientation.TopToBottom ? "btn-primary" : "btn-outline-secondary")" @onclick="ToptoBottomClick" title="Top to Bottom">
                                    <i class="fas fa-arrow-down"></i> TB
                                </button>
                                <button class="btn @(OrientationType == LayoutOrientation.LeftToRight ? "btn-primary" : "btn-outline-secondary")" @onclick="LefttoRightClick" title="Left to Right">
                                    <i class="fas fa-arrow-right"></i> LR
                                </button>
                                <button class="btn @(OrientationType == LayoutOrientation.BottomToTop ? "btn-primary" : "btn-outline-secondary")" @onclick="BottomtoTopClick" title="Bottom to Top">
                                    <i class="fas fa-arrow-up"></i> BT
                                </button>
                                <button class="btn @(OrientationType == LayoutOrientation.RightToLeft ? "btn-primary" : "btn-outline-secondary")" @onclick="RighttoLeftClick" title="Right to Left">
                                    <i class="fas fa-arrow-left"></i> RL
                                </button>
                            </div>
                        </div>
                        <div class="d-flex align-items-center">
                            <label class="form-label small mb-0 me-2">H-Spacing:</label>
                            <SfNumericTextBox TValue="int" @bind-Value="@HorizontalSpacing" Min="20" Max="100" Step="10" Width="80px" CssClass="form-control-sm"></SfNumericTextBox>
                        </div>
                        <div class="d-flex align-items-center">
                            <label class="form-label small mb-0 me-2">V-Spacing:</label>
                            <SfNumericTextBox TValue="int" @bind-Value="@VerticalSpacing" Min="20" Max="100" Step="10" Width="80px" CssClass="form-control-sm"></SfNumericTextBox>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" @bind="IsSamePoint" id="samePointCheck">
                            <label class="form-check-label small" for="samePointCheck">Same Point (reduce crossings)</label>
                        </div>
                        <button class="btn btn-sm btn-outline-primary" @onclick="FitToPage">
                            <i class="fas fa-expand me-1"></i> Fit
                        </button>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card" style="box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
                <div class="card-body py-2">
                    <div class="d-flex flex-wrap gap-3 align-items-center justify-content-center">
                        <div class="d-flex align-items-center">
                            <div style="width: 16px; height: 16px; background-color: #ff6b6b; border-radius: 3px; margin-right: 6px;"></div>
                            <small>Root</small>
                        </div>
                        <div class="d-flex align-items-center">
                            <div style="width: 16px; height: 16px; background-color: #f3904a; border-radius: 3px; margin-right: 6px;"></div>
                            <small>L1 Branch</small>
                        </div>
                        <div class="d-flex align-items-center">
                            <div style="width: 16px; height: 16px; background-color: #efd46e; border-radius: 3px; margin-right: 6px;"></div>
                            <small>Ancestor</small>
                        </div>
                        <div class="d-flex align-items-center">
                            <div style="width: 16px; height: 16px; background-color: #74c0fc; border-radius: 3px; margin-right: 6px;"></div>
                            <small>Immediate Parent</small>
                        </div>
                        <div class="d-flex align-items-center">
                            <div style="width: 16px; height: 16px; background-color: #51cf66; border-radius: 3px; margin-right: 6px;"></div>
                            <small><strong>PNEUMONIA</strong></small>
                        </div>
                        <div class="d-flex align-items-center">
                            <div style="width: 16px; height: 16px; background-color: #659be5; border-radius: 3px; margin-right: 6px;"></div>
                            <small>Child</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Diagram -->
    <div class="row">
        <div class="col-12">
            <div class="card" style="box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
                <div class="card-header bg-light py-2 d-flex justify-content-between align-items-center">
                    <h6 class="mb-0 small">
                        <i class="fas fa-project-diagram me-2"></i>
                        SNOMED CT Polyhierarchy - ComplexHierarchicalTree Layout
                    </h6>
                    <span class="badge bg-info">@DataSource.Count nodes</span>
                </div>
                <div class="card-body p-0">
                    <SfDiagramComponent @ref="@Diagram" 
                                       Created="OnCreated" 
                                       Height="700px" 
                                       NodeCreating="@OnNodeCreating" 
                                       ConnectorCreating="@OnConnectorCreating" 
                                       InteractionController="@DiagramInteractions.ZoomPan">
                        <ScrollSettings @bind-ScrollLimit="@ScrollLimit"></ScrollSettings>
                        <DataSourceSettings ID="Id" ParentID="ReportingPerson" DataSource="DataSource"></DataSourceSettings>
                        <Layout @bind-Type="@LayoutStyle" 
                                @bind-VerticalSpacing="@VerticalSpacing" 
                                @bind-SamePoint="@IsSamePoint" 
                                @bind-HorizontalSpacing="@HorizontalSpacing" 
                                @bind-Orientation="@OrientationType" 
                                HorizontalAlignment="@HorizontalAlignment" 
                                VerticalAlignment="@VerticalAlignment">
                            <LayoutMargin @bind-Top="@TopPosition" @bind-Bottom="@BottomPosition" @bind-Right="@RightPosition" @bind-Left="@LeftPosition"></LayoutMargin>
                        </Layout>
                        <SnapSettings Constraints="SnapConstraints.None"></SnapSettings>
                    </SfDiagramComponent>
                </div>
            </div>
        </div>
    </div>

    <!-- Info Panel -->
    <div class="row mt-3">
        <div class="col-12">
            <div class="card" style="box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
                <div class="card-body py-2">
                    <p class="small mb-0 text-muted">
                        <i class="fas fa-info-circle me-1"></i>
                        <strong>ComplexHierarchicalTree</strong> layout is optimized for polyhierarchies where nodes can have multiple parents. 
                        This is ideal for SNOMED CT's IS-A relationships. Toggle <strong>"Same Point"</strong> to route connectors through shared points and reduce line crossings.
                        Adjust spacing to optimize the layout.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@code
{
    ScrollLimitMode ScrollLimit { get; set; } = ScrollLimitMode.Diagram;
    private bool IsSamePoint { get; set; } = true;
    public SfDiagramComponent? Diagram;
    public LayoutOrientation OrientationType = LayoutOrientation.TopToBottom;
    public LayoutType LayoutStyle = LayoutType.ComplexHierarchicalTree;
    public HorizontalAlignment HorizontalAlignment = HorizontalAlignment.Center;
    public VerticalAlignment VerticalAlignment = VerticalAlignment.Top;
    public int HorizontalSpacing { get; set; } = 80;  // Increased spacing
    public int VerticalSpacing { get; set; } = 80;    // Increased spacing
    public double TopPosition { get; set; } = 50;
    public double BottomPosition { get; set; } = 50;
    public double RightPosition { get; set; } = 50;
    public double LeftPosition { get; set; } = 50;

    private void OnNodeCreating(IDiagramObject obj)
    {
        Node? node = obj as Node;
        SnomedHierarchyItem? item = node!.Data as SnomedHierarchyItem;
        
        // Size based on whether it's the focus node
        node.Width = item!.IsFocus ? 180 : 150;
        node.Height = item.IsFocus ? 60 : 50;
        
        node.Shape = new BasicShape() 
        { 
            Type = Syncfusion.Blazor.Diagram.NodeShapes.Basic, 
            Shape = NodeBasicShapes.Rectangle, 
            CornerRadius = item.IsFocus ? 10 : 6 
        };
        
        node.Style = new ShapeStyle() 
        { 
            Fill = item.FillColor, 
            StrokeWidth = item.IsFocus ? 3 : 1, 
            StrokeColor = item.BorderColor 
        };

        // Add annotation with concept name
        node.Annotations = new DiagramObjectCollection<ShapeAnnotation>()
        {
            new ShapeAnnotation()
            {
                Content = item.Label,
                Style = new TextStyle()
                {
                    Color = "white",
                    FontSize = item.IsFocus ? 11 : 9,
                    Bold = item.IsFocus,
                    TextWrapping = Syncfusion.Blazor.Diagram.TextWrap.Wrap
                }
            }
        };
    }

    private void OnConnectorCreating(IDiagramObject connector1)
    {
        Connector? connector = (connector1 as Connector);
        connector!.Type = ConnectorSegmentType.Orthogonal;
        connector.CornerRadius = 10;
        
        // Add padding to keep connector lines away from node edges
        connector.SourcePadding = 10;
        connector.TargetPadding = 10;
        
        connector.Style = new ShapeStyle()
        {
            StrokeColor = "#6d6d6d",
            StrokeWidth = 1
        };
        connector.TargetDecorator!.Height = 8;
        connector.TargetDecorator.Width = 8;
        connector.TargetDecorator.Style = new ShapeStyle()
        {
            Fill = "#6d6d6d",
            StrokeColor = "#6d6d6d"
        };
    }

    private void OnCreated()
    {
        FitOptions options = new FitOptions() { Mode = FitMode.Both, Region = DiagramRegion.Content };
        Diagram!.FitToPage(options);
    }

    private void FitToPage()
    {
        FitOptions options = new FitOptions() { Mode = FitMode.Both, Region = DiagramRegion.Content };
        Diagram!.FitToPage(options);
    }

    private void ToptoBottomClick() => OrientationType = LayoutOrientation.TopToBottom;
    private void LefttoRightClick() => OrientationType = LayoutOrientation.LeftToRight;
    private void RighttoLeftClick() => OrientationType = LayoutOrientation.RightToLeft;
    private void BottomtoTopClick() => OrientationType = LayoutOrientation.BottomToTop;

