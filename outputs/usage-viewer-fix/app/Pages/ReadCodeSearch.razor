@page "/readcode-search"
@using StaticBlazorSnomed.Models
@using Syncfusion.Blazor
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.Inputs
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Spinner
@inject AzureFunctionService AzureFunctionService
@inject IJSRuntime JSRuntime

<PageTitle>Read Code Search</PageTitle>

<!-- Page Header Section - positioned to align with sidebar -->
<div class="page-header-wrapper">
    <div class="page-header">
        <div class="page-header-content">
            <div class="page-header-main">
                <h4 class="page-title mb-1">Read Code Search</h4>
                <p class="page-subtitle mb-0">Search Read codes to find SNOMED CT mappings using the NHS terminology service</p>
            </div>
            <div class="page-header-actions">
                <span class="created-by">Created by Imran Khan</span>
                <a href="https://github.com" target="_blank" class="github-link">
                    <i class="fab fa-github fa-lg"></i>
                </a>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid" style="margin-top: 0; padding-top: 1rem;">
    <!-- Search Section -->
    <div class="content-section">
        <div class="row mb-4">
            <div class="col-12">
                <div class="card">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <label for="readCodeInput" class="form-label fw-bold">Read Code(s):</label>
                                <SfTextBox @bind-Value="searchInput"
                                          Placeholder="Enter Read code(s), e.g., L14.. or L14..G802.1CB.."
                                          Width="100%"
                                          CssClass="snomed-input-compact"
                                          @onkeypress="HandleKeyPress">
                                </SfTextBox>
                                <small class="form-text text-muted">
                                    Enter single or comma-separated Read codes (case-sensitive, include dots)
                                </small>
                                
                                <div class="d-flex gap-2 mt-3">
                                    <SfButton @onclick="Search" 
                                             Disabled="@isLoading"
                                             CssClass="e-primary search-btn">
                                        @if (isLoading)
                                        {
                                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                        }
                                        SEARCH
                                    </SfButton>
                                    <SfButton @onclick="ClearResults" 
                                             CssClass="e-outline search-btn">
                                        CLEAR
                                    </SfButton>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="info-panel">
                                    @if (searchResult == null || !searchResult.Mappings.Any())
                                    {
                                        <div class="info-panel-header">
                                            <i class="fas fa-info-circle text-primary me-2"></i>
                                            <strong>About Read Code Mappings</strong>
                                        </div>
                                    }
                                    <div class="info-panel-content">
                                        @if (searchResult == null || !searchResult.Mappings.Any())
                                        {
                                            <p class="info-text">
                                                This tool searches mappings between Read v2 codes and SNOMED CT concepts. The data is reproduced from tables created using the NHS Data Migration Workbench (DMWB) released via TRUD.
                                            </p>
                                        }
                                        else
                                        {
                                            <div class="alert alert-info mb-2 py-2 px-3">
                                                <i class="fas fa-check-circle me-2"></i>
                                                Found <strong>@searchResult.TotalMappings</strong> mapping(s) for <strong>@searchResult.UniqueReadCodes</strong> Read code(s) → <strong>@searchResult.UniqueSnomedConcepts</strong> SNOMED concept(s) in <strong>@searchResult.SearchTimeSeconds.ToString("F2")</strong>s
                                            </div>
                                            
                                            @if (searchResult.Mappings.GroupBy(m => m.ReadCode).Any(g => g.Count() > 1))
                                            {
                                                <div class="alert alert-warning mb-0 py-2 px-3">
                                                    <i class="fas fa-exclamation-triangle me-2"></i>
                                                    <strong>Multiple Mappings:</strong> Some Read codes map to multiple TermCodes (different concepts).
                                                </div>
                                            }
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Error Display -->
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>
            <strong>Error:</strong> @errorMessage
        </div>
    }

    <style>
        /* Page Header Styles - matching other pages */
        .page-header-wrapper {
            padding: 0;
            margin: 0;
            border-bottom: 1px solid #dee2e6;
            background-color: #f8f9fa;
        }

        .page-header {
            padding: 15px;
            height: 42px !important;
            min-height: 42px !important;
            max-height: 42px !important;
            box-sizing: border-box;
            display: flex;
            align-items: center;
            max-width: 100%;
            margin: 0;
        }

        .page-header-content {
            display: flex;
            justify-content: space-between;
            align-items: center;
            width: 100%;
            flex-wrap: nowrap;
        }

        .page-header-main {
            flex-grow: 1;
            min-width: 0;
            margin-right: 20px;
        }

        .page-title {
            font-size: 1.1rem;
            font-weight: 500;
            color: #333;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            margin: 0;
            line-height: 1.1;
        }

        .page-subtitle {
            font-size: 0.75rem;
            color: #6c757d;
            margin: 0;
            line-height: 1.1;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .page-header-actions {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-shrink: 0;
        }

        .created-by {
            font-size: 0.75rem;
            color: #6c757d;
            white-space: nowrap;
        }

        .github-link {
            color: #333;
            text-decoration: none;
            transition: color 0.2s;
        }

        .github-link:hover {
            color: #007bff;
        }

        .snomed-input-compact {
            font-size: 0.95rem;
        }

        .search-btn {
            min-width: 100px;
        }

        .info-panel {
            background: #f8f9fa;
            border: 1px solid #e9ecef;
            border-radius: 0.5rem;
            padding: 1.25rem;
            height: 100%;
        }

        .info-panel-header {
            font-size: 0.95rem;
            margin-bottom: 0.75rem;
        }

        .info-panel-content {
            font-size: 0.875rem;
        }

        .info-text {
            font-size: 0.875rem;
            color: #495057;
            margin-bottom: 0;
            line-height: 1.5;
        }

        .search-summary {
            margin-bottom: 0;
        }

        .read-code-badge {
            font-family: 'Consolas', 'Monaco', monospace;
            font-weight: bold;
            color: #1565c0;
            background: #e3f2fd;
            padding: 2px 8px;
            border-radius: 4px;
        }

        .term-badge {
            display: inline-block;
            padding: 2px 8px;
            background: #64b5f6;
            color: white;
            border-radius: 4px;
            font-size: 0.75em;
        }

        .term-badge-lg {
            display: inline-block;
            padding: 4px 12px;
            background: #64b5f6;
            color: white;
            border-radius: 4px;
            font-size: 0.85em;
            font-weight: 500;
        }

        .snomed-link {
            color: #1976d2;
            text-decoration: none;
            font-weight: 600;
        }

        .snomed-link:hover {
            text-decoration: underline;
        }

        .mapping-card {
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
            border-radius: 12px;
            overflow: hidden;
        }

        .mapping-card-header {
            background: #f8f9fa;
            font-size: 0.9em;
            color: #666;
        }

        .read-code-section {
            padding: 12px;
            background: #e3f2fd;
            border: 2px solid #2196f3;
            border-radius: 8px;
        }

        .section-label {
            font-size: 0.75em;
            color: #666;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 8px;
            font-weight: 600;
        }

        .read-code-value {
            font-family: 'Consolas', 'Monaco', monospace;
            font-weight: bold;
            font-size: 1.3em;
            color: #1565c0;
        }

        .read-term {
            font-style: italic;
            color: #004085;
            font-size: 0.95em;
        }

        .snomed-section {
            padding: 12px;
            border-radius: 8px;
        }

        .snomed-active {
            background: #e8f5e9;
            border: 2px solid #4caf50;
        }

        .snomed-inactive {
            background: #ffebee;
            border: 2px solid #f44336;
        }

        .snomed-id-link {
            font-weight: bold;
            font-size: 1.2em;
            color: #1976d2;
            text-decoration: none;
        }

        .snomed-id-link:hover {
            text-decoration: underline;
        }

        .snomed-term-active {
            color: #2e7d32;
            font-style: italic;
        }

        .snomed-term-inactive {
            color: #c62828;
            font-style: italic;
        }

        .replacements-box {
            margin-top: 10px;
            padding: 12px;
            background: #e1f5fe;
            border-left: 3px solid #03a9f4;
            border-radius: 4px;
        }

        .replacement-link {
            color: #0277bd;
            text-decoration: none;
            font-weight: bold;
        }

        .replacement-link:hover {
            text-decoration: underline;
        }

        .quality-section {
            margin-top: 12px;
            padding-top: 12px;
            border-top: 1px solid #eee;
        }

        .quality-assured {
            color: #2e7d32;
            font-weight: 600;
        }

        .quality-not-assured {
            color: #f57c00;
            font-weight: 600;
        }

        /* Syncfusion Grid Customization */
        .e-grid .e-headercell {
            background-color: #f8f9fa;
            font-weight: 600;
        }

        .e-grid .e-row:hover .e-rowcell {
            background-color: #f0f7ff;
        }

    </style>

    @if (searchResult != null && !isLoading)
    {
        @if (searchResult.TotalMappings == 0)
        {
            <div class="alert alert-warning">
                <i class="fas fa-exclamation-circle me-2"></i>
                <strong>No mappings found.</strong> Check that the Read code is correct (case-sensitive, including dots).
            </div>
        }
        else
        {

            <!-- Results Grid using Syncfusion -->
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <span class="fw-bold">
                                <i class="fas fa-table me-2"></i>Read Code Mappings
                            </span>
                            <span class="badge bg-primary">@searchResult.TotalMappings result(s)</span>
                        </div>
                        <div class="card-body p-0">
                            <SfGrid DataSource="@searchResult.Mappings" 
                                    AllowPaging="true" 
                                    AllowSorting="true"
                                    AllowFiltering="true"
                                    AllowResizing="true"
                                    AllowSelection="true"
                                    EnableHover="true"
                                    GridLines="GridLine.Both">
                                <GridPageSettings PageSize="10" PageSizes="true"></GridPageSettings>
                                <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Excel"></GridFilterSettings>
                                <GridColumns>
                                    <GridColumn Field="@nameof(ReadCodeMapping.ReadCode)" 
                                                HeaderText="Read Code" 
                                                Width="120"
                                                TextAlign="TextAlign.Left">
                                        <Template>
                                            @{
                                                var mapping = (context as ReadCodeMapping);
                                                <span class="read-code-badge">@mapping?.ReadCode</span>
                                            }
                                        </Template>
                                    </GridColumn>
                                    <GridColumn Field="@nameof(ReadCodeMapping.TermCode)" 
                                                HeaderText="Term" 
                                                Width="80"
                                                TextAlign="TextAlign.Center">
                                        <Template>
                                            @{
                                                var mapping = (context as ReadCodeMapping);
                                                <span class="term-badge">@mapping?.TermCode</span>
                                            }
                                        </Template>
                                    </GridColumn>
                                    <GridColumn Field="@nameof(ReadCodeMapping.ReadTerm)" 
                                                HeaderText="Read Term" 
                                                Width="200">
                                    </GridColumn>
                                    <GridColumn Field="@nameof(ReadCodeMapping.ConceptId)" 
                                                HeaderText="SNOMED CT ID" 
                                                Width="150">
                                        <Template>
                                            @{
                                                var mapping = (context as ReadCodeMapping);
                                                <a href="http://www.diseasesdatabase.com/snomed/@mapping?.ConceptId" 
                                                   target="_blank" 
                                                   class="snomed-link">
                                                    @mapping?.ConceptId
                                                </a>
                                            }
                                        </Template>
                                    </GridColumn>
                                    <GridColumn Field="@nameof(ReadCodeMapping.SnomedTerm)" 
                                                HeaderText="SNOMED Term" 
                                                Width="250">
                                    </GridColumn>
                                    <GridColumn Field="@nameof(ReadCodeMapping.ConceptIsActive)" 
                                                HeaderText="Status" 
                                                Width="100"
                                                TextAlign="TextAlign.Center">
                                        <Template>
                                            @{
                                                var mapping = (context as ReadCodeMapping);
                                                if (mapping?.ConceptIsActive == true)
                                                {
                                                    <span class="badge bg-success">Active</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger">Inactive</span>
                                                }
                                            }
                                        </Template>
                                    </GridColumn>
                                    <GridColumn Field="@nameof(ReadCodeMapping.IsAssured)" 
                                                HeaderText="Quality" 
                                                Width="110"
                                                TextAlign="TextAlign.Center">
                                        <Template>
                                            @{
                                                var mapping = (context as ReadCodeMapping);
                                                if (mapping?.IsAssured == true)
                                                {
                                                    <span class="badge bg-success">✓ Assured</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning text-dark">⚠ Unverified</span>
                                                }
                                            }
                                        </Template>
                                    </GridColumn>
                                    <GridColumn Field="@nameof(ReadCodeMapping.MapType)" 
                                                HeaderText="Map Type" 
                                                Width="100"
                                                TextAlign="TextAlign.Center">
                                        <Template>
                                            @{
                                                var mapping = (context as ReadCodeMapping);
                                                @if (mapping?.MapType == "E")
                                                {
                                                    <span title="Exact/Equivalent match" class="badge bg-info">E (Exact)</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">@(string.IsNullOrEmpty(mapping?.MapType) ? "N/A" : mapping?.MapType)</span>
                                                }
                                            }
                                        </Template>
                                    </GridColumn>
                                </GridColumns>
                            </SfGrid>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Detailed Mapping Cards -->
            <div class="row mt-4">
                <div class="col-12">
                    <h5 class="mb-3"><i class="fas fa-list-alt me-2"></i>Detailed Mapping Information</h5>
                </div>
            </div>

            @for (int i = 0; i < searchResult.Mappings.Count; i++)
            {
                var mapping = searchResult.Mappings[i];
                var mappingIndex = i + 1;
                
                <div class="row mb-3">
                    <div class="col-12">
                        <div class="card mapping-card">
                            <div class="card-header mapping-card-header">
                                <span>Mapping @mappingIndex of @searchResult.TotalMappings</span>
                            </div>
                            <div class="card-body">
                                <!-- Read Code Section -->
                                <div class="read-code-section mb-3">
                                    <div class="section-label">READ CODE</div>
                                    <div class="d-flex align-items-center flex-wrap gap-2">
                                        <span class="read-code-value">@mapping.ReadCode</span>
                                        <span class="term-badge-lg">Term: @mapping.TermCode</span>
                                        @if (!string.IsNullOrEmpty(mapping.ReadTerm))
                                        {
                                            <span class="read-term">"@mapping.ReadTerm"</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">(Read term not available)</span>
                                        }
                                    </div>
                                </div>

                                <!-- Arrow Indicator -->
                                <div class="text-center my-2">
                                    <i class="fas fa-arrow-down fa-lg text-secondary"></i>
                                    <span class="mx-2 text-muted">maps to</span>
                                    <i class="fas fa-arrow-down fa-lg text-secondary"></i>
                                </div>

                                <!-- SNOMED CT Section -->
                                <div class="snomed-section @(mapping.ConceptIsActive ? "snomed-active" : "snomed-inactive") mb-3">
                                    <div class="section-label">SNOMED CT CONCEPT</div>
                                    <div class="d-flex align-items-center flex-wrap gap-2">
                                        <a href="http://www.diseasesdatabase.com/snomed/@mapping.ConceptId" 
                                           target="_blank" 
                                           class="snomed-id-link">
                                            @mapping.ConceptId
                                        </a>
                                        <span class="@(mapping.ConceptIsActive ? "snomed-term-active" : "snomed-term-inactive")">
                                            "@(mapping.SnomedTerm ?? "No term found")"
                                        </span>
                                    </div>

                                    @if (!mapping.ConceptIsActive)
                                    {
                                        <div class="alert alert-warning mt-3 mb-2">
                                            <i class="fas fa-exclamation-triangle me-2"></i>
                                            <strong>⚠ This SNOMED concept is INACTIVE</strong><br />
                                            <small>Inactivated on: @(mapping.InactivationDate ?? "unknown")</small>
                                        </div>

                                        @if (mapping.ActiveReplacements.Any())
                                        {
                                            <div class="replacements-box">
                                                <strong><i class="fas fa-exchange-alt me-2"></i>Use these active replacement concepts instead:</strong>
                                                <ul class="mt-2 mb-0">
                                                    @foreach (var replacement in mapping.ActiveReplacements)
                                                    {
                                                        <li>
                                                            <a href="http://www.diseasesdatabase.com/snomed/@replacement.ConceptId" 
                                                               target="_blank"
                                                               class="replacement-link">
                                                                @replacement.ConceptId
                                                            </a>
                                                            - @(replacement.Term ?? "No term available")
                                                        </li>
                                                    }
                                                </ul>
                                            </div>
                                        }
                                    }
                                </div>

                                <!-- Quality Section -->
                                <div class="quality-section">
                                    <div class="row">
                                        <div class="col-md-4">
                                            <strong>Map Quality:</strong>
                                            @if (mapping.IsAssured)
                                            {
                                                <span class="quality-assured ms-2">
                                                    <i class="fas fa-check-circle"></i> NHS Assured (verified)
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="quality-not-assured ms-2">
                                                    <i class="fas fa-exclamation-circle"></i> Not Assured (unverified)
                                                </span>
                                            }
                                        </div>
                                        <div class="col-md-4">
                                            <strong>Map Type:</strong>
                                            @if (mapping.MapType == "E")
                                            {
                                                <span class="ms-2"><strong>E</strong> = Exact/Equivalent match</span>
                                            }
                                            else
                                            {
                                                <span class="ms-2">@(string.IsNullOrEmpty(mapping.MapType) ? "N/A" : mapping.MapType)</span>
                                            }
                                        </div>
                                        <div class="col-md-4">
                                            <strong>Description ID:</strong>
                                            <span class="ms-2 text-muted">@(string.IsNullOrEmpty(mapping.DescriptionId) ? "N/A" : mapping.DescriptionId)</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    }
</div>

@code {
    private string searchInput = string.Empty;
    private ReadCodeSearchResult? searchResult;
    private bool isLoading = false;
    private string? errorMessage;

    private async Task HandleKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await Search();
        }
    }

    private async Task Search()
    {
        if (string.IsNullOrWhiteSpace(searchInput))
        {
            errorMessage = "Please enter a Read code to search.";
            return;
        }

        isLoading = true;
        errorMessage = null;
        searchResult = null;

        try
        {
            searchResult = await AzureFunctionService.SearchReadCodesAsync(searchInput.Trim());
        }
        catch (Exception ex)
        {
            errorMessage = $"Search failed: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ClearResults()
    {
        searchInput = string.Empty;
        searchResult = null;
        errorMessage = null;
    }
}
