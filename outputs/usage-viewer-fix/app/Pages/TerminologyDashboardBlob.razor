@page "/terminology"
@page "/terminology-dashboard"
@using System.Text.Json
@using System.Text.Json.Serialization
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.Popups
@inject HttpClient Http
@inject IConfiguration Configuration

<PageTitle>Terminology Updates Dashboard</PageTitle>

<!-- Page Header Section - positioned to align with sidebar -->
<div class="page-header-wrapper">
    <div class="page-header">
        <div class="page-header-content">
            <div class="page-header-main">
                <h4 class="page-title mb-1">Terminology Updates Dashboard</h4>
                <p class="page-subtitle mb-0">SNOMED CT and DM+D database update status - Personal use only</p>
            </div>
            <div class="page-header-actions">
                <span class="created-by">Created by Imran Khan</span>
                <a href="https://github.com" target="_blank" class="github-link">
                    <i class="fab fa-github fa-lg"></i>
                </a>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid" style="margin-top: 0; padding-top: 1rem;">
    @if (_loading)
    {
        <div class="content-section">
            <div class="card">
                <div class="card-body text-center py-5">
                    <div class="spinner-border text-primary mb-3" role="status" style="width: 3rem; height: 3rem;"></div>
                    <h5>Loading dashboard data...</h5>
                    <p class="text-muted">Fetching latest terminology update status</p>
                </div>
            </div>
        </div>
    }
    else if (_error != null)
    {
        <div class="content-section">
            <div class="alert alert-danger" role="alert">
                <div class="d-flex align-items-center">
                    <i class="fas fa-exclamation-triangle fa-2x me-3"></i>
                    <div>
                        <h5 class="mb-1">⚠️ Error Loading Data</h5>
                        <p class="mb-2">@_error</p>
                        <SfButton @onclick="LoadData" CssClass="e-danger e-outline">
                            <i class="fas fa-sync-alt me-2"></i>Retry
                        </SfButton>
                    </div>
                </div>
            </div>
        </div>
    }
    else if (_data != null)
    {
        <!-- Last Updated Banner -->
        <div class="content-section mb-3">
            <div class="alert @(_data.LatestRun?.OverallSuccess == true ? "alert-success" : "alert-danger") d-flex justify-content-between align-items-center mb-0">
                <div class="d-flex align-items-center">
                    <i class="fas @(_data.LatestRun?.OverallSuccess == true ? "fa-check-circle" : "fa-times-circle") fa-lg me-3"></i>
                    <div>
                        <strong>Last Update:</strong> @(_data.LatestRun?.StartTime?.ToString("dddd, dd MMMM yyyy 'at' HH:mm") ?? "Unknown")
                        <span class="badge @(_data.LatestRun?.OverallSuccess == true ? "bg-success" : "bg-danger") ms-2">
                            @(_data.LatestRun?.OverallSuccess == true ? "SUCCESS" : "FAILED")
                        </span>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <small class="text-muted">Data exported: @_data.ExportedAt?.ToString("dd MMM yyyy HH:mm")</small>
                    <SfButton @onclick="LoadData" CssClass="e-outline e-small">
                        <i class="fas fa-sync-alt me-1"></i>Refresh
                    </SfButton>
                </div>
            </div>
        </div>

        <!-- Personal Use Warning -->
        <div class="content-section mb-3">
            <div class="alert alert-warning py-2" role="alert">
                <i class="fas fa-exclamation-triangle me-2"></i>
                <strong>Personal Use Only:</strong> These servers are maintained for personal use and there should be no commercial use. 
                If you are seeking a commercial solution, please use the <strong>NHS England terminology services</strong>.
            </div>
        </div>

        <!-- Info Panel -->
        <div class="content-section mb-3">
            <div class="card shadow-sm">
                <div class="card-body py-2">
                    <div class="info-panel">
                        <div class="info-panel-header mb-2">
                            <i class="fas fa-info-circle text-primary me-2"></i>
                            <strong>About This Dashboard</strong>
                        </div>
                        <div class="info-panel-content">
                            <p class="info-text mb-2 small">
                                This dashboard displays the status of <strong>automated weekly terminology updates</strong> for the local SNOMED CT and DM+D databases.
                            </p>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="info-highlight mb-2">
                                        <h6 class="info-subtitle small"><i class="fas fa-database me-2"></i>Data Sources</h6>
                                        <p class="info-detail small text-muted mb-0">
                                            Updates are sourced from <strong>TRUD</strong> (NHS Technology Reference-data Update Distribution) and validated against the <strong>NHS Ontology Server</strong>.
                                        </p>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="info-highlight mb-2">
                                        <h6 class="info-subtitle small"><i class="fas fa-calendar-alt me-2"></i>Update Schedule</h6>
                                        <p class="info-detail small text-muted mb-0">
                                            The automated import runs <strong>weekly on Saturday at 12:00</strong>. New releases are downloaded, imported, and validated automatically.
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Stats Cards Row -->
        <div class="content-section">
            <div class="row mb-4">
                <div class="col-md-4 mb-3">
                    <div class="card h-100 border-0 shadow-sm">
                        <div class="card-body text-center" style="background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 100%); color: white; border-radius: 0.375rem;">
                            <i class="fas fa-clock fa-2x mb-2 opacity-75"></i>
                            <h6 class="card-subtitle mb-2 opacity-75">Duration</h6>
                            <h2 class="mb-0 fw-bold">@(_data.LatestRun?.DurationFormatted ?? "—")</h2>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 mb-3">
                    <div class="card h-100 border-0 shadow-sm">
                        <div class="card-body text-center" style="background: linear-gradient(135deg, #0dcaf0 0%, #0aa2c0 100%); color: white; border-radius: 0.375rem;">
                            <i class="fas fa-download fa-2x mb-2 opacity-75"></i>
                            <h6 class="card-subtitle mb-2 opacity-75">Updates Found</h6>
                            <h2 class="mb-0 fw-bold">@(_data.LatestRun?.UpdatesFound ?? 0)</h2>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 mb-3">
                    <div class="card h-100 border-0 shadow-sm">
                        <div class="card-body text-center" style="background: linear-gradient(135deg, @(_data.LatestRun?.ErrorCount > 0 ? "#dc3545" : "#198754") 0%, @(_data.LatestRun?.ErrorCount > 0 ? "#b02a37" : "#146c43") 100%); color: white; border-radius: 0.375rem;">
                            <i class="fas @(_data.LatestRun?.ErrorCount > 0 ? "fa-exclamation-circle" : "fa-check-circle") fa-2x mb-2 opacity-75"></i>
                            <h6 class="card-subtitle mb-2 opacity-75">Errors</h6>
                            <h2 class="mb-0 fw-bold">@(_data.LatestRun?.ErrorCount ?? 0)</h2>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- SNOMED CT and DM+D Cards -->
        <div class="content-section">
            <div class="row">
                <!-- SNOMED CT Card -->
                <div class="col-lg-6 mb-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-header d-flex justify-content-between align-items-center bg-light">
                            <div class="d-flex align-items-center">
                                <i class="fas fa-microscope fa-lg text-primary me-2"></i>
                                <h5 class="mb-0">SNOMED CT</h5>
                            </div>
                            @if (_data.Snomed?.NewRelease == true)
                            {
                                <span class="badge bg-warning text-dark">
                                    <i class="fas fa-star me-1"></i>NEW RELEASE
                                </span>
                            }
                            else
                            {
                                <span class="badge @(_data.Snomed?.Success == true ? "bg-success" : "bg-secondary")">
                                    @(_data.Snomed?.Success == true ? "✓ OK" : "—")
                                </span>
                            }
                        </div>
                        <div class="card-body">
                            <div class="table-responsive">
                                <table class="table table-sm table-borderless mb-0">
                                    <tbody>
                                        <tr>
                                            <th style="width: 40%" class="text-muted">Version</th>
                                            <td>@FormatSnomedVersion(_data.Snomed?.ReleaseVersion)</td>
                                        </tr>
                                        <tr>
                                            <th class="text-muted">Concepts</th>
                                            <td class="fw-bold">@(_data.Snomed?.ConceptCount?.ToString("N0") ?? "—")</td>
                                        </tr>
                                        <tr>
                                            <th class="text-muted">Descriptions</th>
                                            <td class="fw-bold">@(_data.Snomed?.DescriptionCount?.ToString("N0") ?? "—")</td>
                                        </tr>
                                        <tr>
                                            <th class="text-muted">Relationships</th>
                                            <td class="fw-bold">@(_data.Snomed?.RelationshipCount?.ToString("N0") ?? "—")</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                            
                            @if (_data.Snomed?.Steps?.Any() == true)
                            {
                                <hr class="my-3" />
                                <h6 class="text-muted mb-2"><i class="fas fa-list-check me-2"></i>Processing Steps</h6>
                                <div class="steps-list">
                                    @foreach (var step in _data.Snomed.Steps)
                                    {
                                        <div class="step-item d-flex align-items-start mb-2">
                                            <span class="step-icon me-2">
                                                @if (step.Success)
                                                {
                                                    <i class="fas fa-check-circle text-success"></i>
                                                }
                                                else
                                                {
                                                    <i class="fas fa-times-circle text-danger"></i>
                                                }
                                            </span>
                                            <div class="step-content">
                                                <span class="step-name">@step.Name</span>
                                                @if (!string.IsNullOrEmpty(step.Details))
                                                {
                                                    <span class="step-details text-muted ms-1">— @step.Details</span>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- DM+D Card -->
                <div class="col-lg-6 mb-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-header d-flex justify-content-between align-items-center bg-light">
                            <div class="d-flex align-items-center">
                                <i class="fas fa-pills fa-lg text-success me-2"></i>
                                <h5 class="mb-0">DM+D</h5>
                            </div>
                            @if (_data.Dmd?.NewRelease == true)
                            {
                                <span class="badge bg-warning text-dark">
                                    <i class="fas fa-star me-1"></i>NEW RELEASE
                                </span>
                            }
                            else
                            {
                                <span class="badge @(_data.Dmd?.Success == true ? "bg-success" : "bg-secondary")">
                                    @(_data.Dmd?.Success == true ? "✓ OK" : "—")
                                </span>
                            }
                        </div>
                        <div class="card-body">
                            <div class="table-responsive">
                                <table class="table table-sm table-borderless mb-3">
                                    <tbody>
                                        <tr>
                                            <th style="width: 40%" class="text-muted">Version</th>
                                            <td>@FormatDmdVersion(_data.Dmd?.ReleaseVersion)</td>
                                        </tr>
                                        <tr>
                                            <th class="text-muted">VTMs</th>
                                            <td class="fw-bold">@(_data.Dmd?.VtmCount?.ToString("N0") ?? "—")</td>
                                        </tr>
                                        <tr>
                                            <th class="text-muted">VMPs</th>
                                            <td class="fw-bold">@(_data.Dmd?.VmpCount?.ToString("N0") ?? "—")</td>
                                        </tr>
                                        <tr>
                                            <th class="text-muted">AMPs</th>
                                            <td class="fw-bold">@(_data.Dmd?.AmpCount?.ToString("N0") ?? "—")</td>
                                        </tr>
                                        <tr>
                                            <th class="text-muted">VMPPs</th>
                                            <td class="fw-bold">@(_data.Dmd?.VmppCount?.ToString("N0") ?? "—")</td>
                                        </tr>
                                        <tr>
                                            <th class="text-muted">AMPPs</th>
                                            <td class="fw-bold">@(_data.Dmd?.AmppCount?.ToString("N0") ?? "—")</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                            
                            <!-- Validation Rates -->
                            @if (_data.Dmd?.XmlValidationRate != null || _data.Dmd?.SnomedValidationRate != null)
                            {
                                <h6 class="text-muted mb-2"><i class="fas fa-check-double me-2"></i>Validation Rates</h6>
                                <div class="row mb-3">
                                    @if (_data.Dmd?.XmlValidationRate != null)
                                    {
                                        <div class="col-6">
                                            <div class="validation-metric">
                                                <div class="progress mb-1" style="height: 24px; border-radius: 0.375rem;">
                                                    <div class="progress-bar bg-success" 
                                                         role="progressbar"
                                                         style="width: @(_data.Dmd.XmlValidationRate)%"
                                                         aria-valuenow="@_data.Dmd.XmlValidationRate" 
                                                         aria-valuemin="0" 
                                                         aria-valuemax="100">
                                                        @(_data.Dmd.XmlValidationRate)%
                                                    </div>
                                                </div>
                                                <small class="text-muted">XML Validation</small>
                                            </div>
                                        </div>
                                    }
                                    @if (_data.Dmd?.SnomedValidationRate != null)
                                    {
                                        <div class="col-6">
                                            <div class="validation-metric">
                                                <div class="progress mb-1" style="height: 24px; border-radius: 0.375rem;">
                                                    <div class="progress-bar @(_data.Dmd.SnomedValidationRate >= 90 ? "bg-success" : "bg-warning")" 
                                                         role="progressbar"
                                                         style="width: @(_data.Dmd.SnomedValidationRate)%"
                                                         aria-valuenow="@_data.Dmd.SnomedValidationRate" 
                                                         aria-valuemin="0" 
                                                         aria-valuemax="100">
                                                        @(_data.Dmd.SnomedValidationRate.Value.ToString("F1"))%
                                                    </div>
                                                </div>
                                                <small class="text-muted">SNOMED Validation</small>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            
                            @if (_data.Dmd?.Steps?.Any() == true)
                            {
                                <hr class="my-3" />
                                <h6 class="text-muted mb-2"><i class="fas fa-list-check me-2"></i>Processing Steps</h6>
                                <div class="steps-list">
                                    @foreach (var step in _data.Dmd.Steps)
                                    {
                                        <div class="step-item d-flex align-items-start mb-2">
                                            <span class="step-icon me-2">
                                                @if (step.Success)
                                                {
                                                    <i class="fas fa-check-circle text-success"></i>
                                                }
                                                else
                                                {
                                                    <i class="fas fa-times-circle text-danger"></i>
                                                }
                                            </span>
                                            <div class="step-content">
                                                <span class="step-name">@step.Name</span>
                                                @if (!string.IsNullOrEmpty(step.Details))
                                                {
                                                    <span class="step-details text-muted ms-1">— @step.Details</span>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Errors Section -->
        @if (_data.Errors?.Any() == true)
        {
            <div class="content-section">
                <div class="card border-danger shadow-sm mb-4">
                    <div class="card-header bg-danger text-white d-flex align-items-center">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        <h5 class="mb-0">Errors (@_data.Errors.Count)</h5>
                    </div>
                    <div class="card-body">
                        <ul class="mb-0 error-list">
                            @foreach (var error in _data.Errors)
                            {
                                <li class="text-danger mb-1">
                                    <i class="fas fa-times me-2"></i>@error
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
        }

        <!-- Footer -->
        <div class="content-section">
            <div class="text-muted small text-center py-3">
                <span class="me-3">
                    <i class="fas fa-fingerprint me-1"></i>Run ID: <code>@_data.RunId</code>
                </span>
                <span>
                    <i class="fas fa-code-branch me-1"></i>Export Version: @_data.ExportVersion
                </span>
            </div>
        </div>
    }
</div>

<style>
    .content-section {
        margin-bottom: 1rem;
    }
    
    .steps-list {
        font-size: 0.9rem;
    }
    
    .step-item {
        padding: 0.25rem 0;
    }
    
    .step-icon {
        min-width: 1.25rem;
        text-align: center;
    }
    
    .step-name {
        font-weight: 500;
    }
    
    .step-details {
        font-size: 0.85em;
    }
    
    .validation-metric {
        text-align: center;
    }
    
    .error-list {
        list-style: none;
        padding-left: 0;
    }
    
    .error-list li {
        padding: 0.5rem 0;
        border-bottom: 1px solid #f1aeb5;
    }
    
    .error-list li:last-child {
        border-bottom: none;
    }
    
    .info-panel {
        background-color: #f8f9fa;
        border-radius: 0.375rem;
        padding: 1rem;
    }
    
    .info-panel-header {
        font-size: 1rem;
        color: #212529;
    }
    
    .info-highlight {
        background-color: white;
        border-radius: 0.375rem;
        padding: 0.75rem;
        border-left: 3px solid #0d6efd;
    }
    
    .info-subtitle {
        font-size: 0.9rem;
        color: #495057;
        margin-bottom: 0.25rem;
    }
    
    code {
        font-size: 0.85em;
    }
</style>

@code {
    // ========================================================
    // CONFIGURATION
    // ========================================================
    // Read-only SAS URL is read from configuration (user-secrets locally,
    // app settings / Key Vault when deployed). Key: "TerminologyDashboard:BlobSasUrl".
    private string BlobUrl => Configuration["TerminologyDashboard:BlobSasUrl"]
        ?? throw new InvalidOperationException(
            "Missing config key 'TerminologyDashboard:BlobSasUrl'. Set it via user-secrets (dotnet user-secrets set) or appsettings.");

    private DashboardData? _data;
    private bool _loading = true;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        _loading = true;
        _error = null;
        StateHasChanged();

        try
        {
            // Add cache-busting parameter to avoid stale data
            // The BlobUrl already has query params, so use & instead of ?
            var url = $"{BlobUrl}&_={DateTime.UtcNow.Ticks}";
            _data = await Http.GetFromJsonAsync<DashboardData>(url, new JsonSerializerOptions
            {
                PropertyNameCaseInsensitive = true
            });
        }
        catch (HttpRequestException ex)
        {
            _error = $"Failed to load data: {ex.Message}. Check that the blob URL is correct and accessible.";
        }
        catch (JsonException ex)
        {
            _error = $"Failed to parse JSON: {ex.Message}";
        }
        catch (Exception ex)
        {
            _error = $"Unexpected error: {ex.Message}";
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    // ========================================================
    // DATA MODELS
    // ========================================================
    
    public class DashboardData
    {
        public DateTime? ExportedAt { get; set; }
        public string? RunId { get; set; }
        public string? ExportVersion { get; set; }
        public LatestRunData? LatestRun { get; set; }
        public SnomedData? Snomed { get; set; }
        public DmdData? Dmd { get; set; }
        public List<string>? Errors { get; set; }
    }

    public class LatestRunData
    {
        public string? RunId { get; set; }
        public DateTime? StartTime { get; set; }
        public DateTime? EndTime { get; set; }
        public string? DurationFormatted { get; set; }
        public bool? OverallSuccess { get; set; }
        public int? UpdatesFound { get; set; }
        public string? ServerName { get; set; }
        public int? ErrorCount { get; set; }
    }

    public class SnomedData
    {
        public bool? Success { get; set; }
        public bool? NewRelease { get; set; }
        public string? ReleaseVersion { get; set; }
        public long? ConceptCount { get; set; }
        public long? DescriptionCount { get; set; }
        public long? RelationshipCount { get; set; }
        public List<StepData>? Steps { get; set; }
    }

    public class DmdData
    {
        public bool? Success { get; set; }
        public bool? NewRelease { get; set; }
        public string? ReleaseVersion { get; set; }
        public int? VtmCount { get; set; }
        public int? VmpCount { get; set; }
        public int? AmpCount { get; set; }
        public int? VmppCount { get; set; }
        public int? AmppCount { get; set; }
        public int? IngredientCount { get; set; }
        public decimal? XmlValidationRate { get; set; }
        public decimal? SnomedValidationRate { get; set; }
        public List<StepData>? Steps { get; set; }
    }

    public class StepData
    {
        public string? Name { get; set; }
        public bool Success { get; set; }
        public string? Details { get; set; }
        public string? Duration { get; set; }
    }

    // ========================================================
    // VERSION FORMATTING HELPERS
    // ========================================================
    
    /// <summary>
    /// Formats SNOMED version (e.g., "uk_sct2mo_41.4.0_20260114000001Z" → "14 Jan 2026 (uk_sct2mo_41.4.0)")
    /// </summary>
    private string FormatSnomedVersion(string? version)
    {
        if (string.IsNullOrEmpty(version)) return "N/A";
        
        // Pattern: uk_sct2XX_X.X.X_YYYYMMDDHHMMSSZ (e.g., uk_sct2mo_41.4.0_20260114000001Z)
        var match = System.Text.RegularExpressions.Regex.Match(
            version, 
            @"(uk_sct2\w+_[\d.]+)_(\d{8})");
        
        if (match.Success)
        {
            var releaseId = match.Groups[1].Value;
            var dateStr = match.Groups[2].Value;
            
            if (DateTime.TryParseExact(dateStr, "yyyyMMdd", null, 
                System.Globalization.DateTimeStyles.None, out var date))
            {
                return $"{date:d MMM yyyy} ({releaseId})";
            }
            
            return releaseId;
        }
        
        // Fallback for old YYYYMMDD format
        if (version.Length >= 8 && DateTime.TryParseExact(
            version.Substring(0, 8), 
            "yyyyMMdd", 
            null, 
            System.Globalization.DateTimeStyles.None, 
            out var fallbackDate))
        {
            return fallbackDate.ToString("d MMM yyyy");
        }
        
        return version;
    }

    /// <summary>
    /// Formats DM+D version (e.g., "nhsbsa_dmd_1.3.0_20260119000001" → "19 Jan 2026 (v1.3.0)")
    /// </summary>
    private string FormatDmdVersion(string? version)
    {
        if (string.IsNullOrEmpty(version)) return "N/A";
        
        // Pattern: nhsbsa_dmd_X.X.X_YYYYMMDDHHMMSS
        var match = System.Text.RegularExpressions.Regex.Match(
            version, 
            @"nhsbsa_dmd(?:bonus)?_([\d.]+)_(\d{8})");
        
        if (match.Success)
        {
            var semver = match.Groups[1].Value;
            var dateStr = match.Groups[2].Value;
            
            if (DateTime.TryParseExact(dateStr, "yyyyMMdd", null, 
                System.Globalization.DateTimeStyles.None, out var date))
            {
                return $"{date:d MMM yyyy} (v{semver})";
            }
            
            return $"v{semver}";
        }
        
        return version;
    }
}
