        padding: 0;
        margin: 0;
        border-bottom: 1px solid #dee2e6;
        background-color: #f8f9fa;
    }
    .page-header {
        padding: 15px;
        height: 42px !important;
        min-height: 42px !important;
        max-height: 42px !important;
        box-sizing: border-box;
        display: flex;
        align-items: center;
        max-width: 100%;
        margin: 0;
    }
    .page-header-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
        width: 100%;
        flex-wrap: nowrap;
    }
    .page-header-main {
        flex-grow: 1;
        min-width: 0;
        margin-right: 20px;
    }
    .page-title {
        font-size: 1.1rem;
        font-weight: 500;
        color: #333;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        margin: 0;
        line-height: 1.1;
    }
    .page-subtitle {
        font-size: 0.75rem;
        color: #6c757d;
        margin: 0;
        line-height: 1.1;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .page-header-actions {
        display: flex;
        align-items: center;
        gap: 15px;
        flex-shrink: 0;
        margin-left: auto;
        justify-content: flex-end;
        min-width: fit-content;
    }
    .created-by {
        font-size: 0.8rem;
