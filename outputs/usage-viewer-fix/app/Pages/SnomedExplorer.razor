@page "/snomed-explorer"
@using Syncfusion.Blazor.Inputs
@using Syncfusion.Blazor.Diagram
@using Syncfusion.Blazor.Buttons
@using System.Net.Http.Json
@inject HttpClient Http
@inject IJSRuntime JSRuntime

<PageTitle>SNOMED CT Interactive Explorer</PageTitle>

<!-- Page Header Section -->
<div class="page-header-wrapper">
    <div class="page-header">
        <div class="page-header-content">
            <div class="page-header-main">
                <h4 class="page-title mb-1">SNOMED CT Interactive Hierarchy Explorer</h4>
                <p class="page-subtitle mb-0">Click nodes to expand parents (↑) or children (↓)</p>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid" style="margin-top: 0; padding-top: 1rem;">
    <!-- Search Box -->
    <div class="row mb-3">
        <div class="col-md-8">
            <div class="input-group">
                <input type="text" class="form-control" placeholder="Enter SNOMED CT Concept ID (e.g., 233604007 for Pneumonia)" 
                       @bind="searchConceptId" @bind:event="oninput" @onkeypress="HandleKeyPress" />
                <button class="btn btn-primary" @onclick="SearchConcept" disabled="@isLoading">
                    @if (isLoading)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                    }
                    <i class="fas fa-search me-1"></i> Explore
                </button>
                <button class="btn btn-outline-secondary" @onclick="ClearDiagram" title="Clear diagram">
                    <i class="fas fa-trash"></i>
                </button>
            </div>
        </div>
        <div class="col-md-4 text-end">
            <span class="badge bg-info me-2">Nodes: @nodes.Count</span>
            <span class="badge bg-secondary">Connections: @connectors.Count</span>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = string.Empty"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(infoMessage))
    {
        <div class="alert alert-info alert-dismissible fade show" role="alert">
            @infoMessage
            <button type="button" class="btn-close" @onclick="() => infoMessage = string.Empty"></button>
        </div>
    }

    <!-- Legend -->
    <div class="row mb-3">
        <div class="col-12">
            <div class="card" style="box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
                <div class="card-body py-2">
                    <div class="d-flex flex-wrap gap-4 align-items-center justify-content-center">
                        <div class="d-flex align-items-center">
                            <div style="width: 20px; height: 20px; background-color: #ff6b6b; border-radius: 4px; margin-right: 8px;"></div>
                            <small><strong>Search Term</strong></small>
                        </div>
                        <div class="d-flex align-items-center">
                            <div style="width: 20px; height: 20px; background-color: #4dabf7; border-radius: 4px; margin-right: 8px;"></div>
                            <small>Parent (IS-A)</small>
                        </div>
                        <div class="d-flex align-items-center">
                            <div style="width: 20px; height: 20px; background-color: #69db7c; border-radius: 4px; margin-right: 8px;"></div>
                            <small>Child</small>
                        </div>
                        <div class="d-flex align-items-center">
                            <div style="width: 12px; height: 12px; background-color: #ffd43b; border-radius: 50%; margin-right: 8px;"></div>
                            <small>Has more to expand</small>
                        </div>
                    </div>
                    <div class="mt-2 text-center">
                        <small class="text-muted">
                            <strong><i class="fas fa-mouse-pointer"></i> Single click</strong> = Expand Parents & Children | 
                            <i class="fas fa-hand-paper"></i> Drag to pan | 
                            <i class="fas fa-search-plus"></i> Scroll to zoom
                        </small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Diagram -->
    <div class="row">
        <div class="col-12">
            <div class="card" style="box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
                <div class="card-header bg-light py-2 d-flex justify-content-between align-items-center">
                    <h6 class="mb-0 small">
                        <i class="fas fa-project-diagram me-2"></i>
                        Interactive Hierarchy - @(focusConceptName ?? "Enter a concept ID to begin")
                    </h6>
                    <div class="btn-group btn-group-sm">
                        <button class="btn btn-outline-secondary" @onclick="ExpandAllParents" disabled="@isLoading" title="Expand all parent levels">
                            <i class="fas fa-arrow-up"></i> All Parents
                        </button>
                        <button class="btn btn-outline-secondary" @onclick="ExpandAllChildren" disabled="@isLoading" title="Expand all child levels (max 3)">
                            <i class="fas fa-arrow-down"></i> All Children
                        </button>
                        <button class="btn btn-outline-secondary" @onclick="FitToPage" title="Fit to Page">
                            <i class="fas fa-expand"></i>
                        </button>
                        <button class="btn btn-outline-secondary" @onclick="ToggleOrientation" title="Toggle orientation">
                            <i class="fas fa-sync"></i>
                        </button>
                    </div>
                </div>
                <div class="card-body p-0">
                    <SfDiagramComponent @ref="@Diagram" 
                                       Height="650px" 
                                       Nodes="@nodes"
                                       Connectors="@connectors"
                                       SelectionChanged="@OnSelectionChanged"
                                       Click="@OnDiagramClick"
                                       InteractionController="@DiagramInteractions.ZoomPan">
                        <ScrollSettings @bind-ScrollLimit="@scrollLimit"></ScrollSettings>
                        <SnapSettings Constraints="SnapConstraints.None"></SnapSettings>
                        <Layout @bind-Type="@layoutType" 
                                @bind-VerticalSpacing="@verticalSpacing" 
                                @bind-HorizontalSpacing="@horizontalSpacing" 
                                @bind-Orientation="@orientation"
                                HorizontalAlignment="HorizontalAlignment.Center"
                                VerticalAlignment="VerticalAlignment.Center">
                            <LayoutMargin Top="50" Bottom="50" Right="50" Left="50"></LayoutMargin>
                        </Layout>
                    </SfDiagramComponent>
                </div>
            </div>
        </div>
    </div>

    <!-- Selected Node Info -->
    @if (selectedNode != null)
    {
        <div class="row mt-3">
            <div class="col-12">
                <div class="card border-primary">
                    <div class="card-header bg-primary text-white py-2">
                        <strong>@selectedNode.Term</strong> (@selectedNode.ConceptId)
                    </div>
                    <div class="card-body py-2">
                        <div class="row">
                            <div class="col-md-6">
                                <small class="text-muted">FSN:</small> @selectedNode.FSN<br/>
                                <small class="text-muted">Type:</small> @selectedNode.NodeType
                                @if (selectedNode.ParentCount > 0)
                                {
                                    <br/><small class="text-muted">Parents:</small> @selectedNode.ParentCount
                                }
                                @if (selectedNode.ChildCount > 0)
                                {
                                    <br/><small class="text-muted">Children:</small> @selectedNode.ChildCount
                                }
                            </div>
                            <div class="col-md-6 text-end">
                                @if (!selectedNode.ParentsExpanded && selectedNode.HasMoreParents)
                                {
                                    <button class="btn btn-sm btn-outline-primary me-2" @onclick="() => ExpandParents(selectedNode)" disabled="@isLoading">
                                        <i class="fas fa-arrow-up"></i> Expand Parents
                                    </button>
                                }
                                @if (!selectedNode.ChildrenExpanded && selectedNode.HasMoreChildren)
                                {
                                    <button class="btn btn-sm btn-outline-success" @onclick="() => ExpandChildren(selectedNode)" disabled="@isLoading">
                                        <i class="fas fa-arrow-down"></i> Expand Children (@selectedNode.ChildCount)
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

