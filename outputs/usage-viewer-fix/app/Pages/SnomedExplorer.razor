    private async Task HandleKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SearchConcept();
        }
    }

    private async Task SearchConcept()
    {
        if (string.IsNullOrWhiteSpace(searchConceptId))
        {
            errorMessage = "Please enter a SNOMED CT Concept ID";
            return;
        }

        await ClearDiagram();
        isLoading = true;
        errorMessage = string.Empty;
        infoMessage = string.Empty;

        try
        {
            var conceptData = await GetConceptWithRelatives(searchConceptId.Trim());
            
            if (conceptData.Focus == null)
            {
                errorMessage = $"Concept ID '{searchConceptId}' not found. Try 233604007 (Pneumonia) for demo.";
                return;
            }

            focusConceptName = conceptData.Focus.Term;
            focusConceptId = conceptData.Focus.ConceptId;

            // Add focus node
            AddNode(conceptData.Focus, true);
            
            infoMessage = $"Loaded {focusConceptName}. Click the node or use buttons below to expand parents/children.";

            await RefreshLayout();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ExpandParents(SnomedNode node)
    {
        if (node.ParentsExpanded) return;
        
        isLoading = true;
        try
        {
            var data = await GetConceptWithRelatives(node.ConceptId, "Parents");
            
            foreach (var parent in data.Parents)
            {
                if (!loadedConcepts.ContainsKey(parent.ConceptId))
                {
                    AddNode(parent, false);
                }
                AddConnector(node.ConceptId, parent.ConceptId);
            }

            node.ParentsExpanded = true;
            node.HasMoreParents = false;
            UpdateNodeAppearance(node);
            await RefreshLayout();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error expanding parents: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ExpandChildren(SnomedNode node)
    {
        if (node.ChildrenExpanded) return;
        
        isLoading = true;
        try
        {
            var data = await GetConceptWithRelatives(node.ConceptId, "Children");
            
            foreach (var child in data.Children)
            {
                if (!loadedConcepts.ContainsKey(child.ConceptId))
                {
                    AddNode(child, false);
                }
                AddConnector(child.ConceptId, node.ConceptId);
            }

            node.ChildrenExpanded = true;
            node.HasMoreChildren = false;
            UpdateNodeAppearance(node);
            await RefreshLayout();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error expanding children: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ExpandAllParents()
    {
        if (string.IsNullOrEmpty(focusConceptId)) return;
        
        isLoading = true;
        int iterations = 0;
        int maxIterations = 20; // Safety limit
        
        try
        {
            var nodesToExpand = loadedConcepts.Values
                .Where(n => !n.ParentsExpanded && n.HasMoreParents)
                .ToList();

            while (nodesToExpand.Any() && iterations < maxIterations)
            {
                foreach (var node in nodesToExpand)
                {
                    await ExpandParents(node);
                }
                
                nodesToExpand = loadedConcepts.Values
                    .Where(n => !n.ParentsExpanded && n.HasMoreParents)
                    .ToList();
                    
                iterations++;
            }
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ExpandAllChildren()
    {
        if (string.IsNullOrEmpty(focusConceptId)) return;
        
        isLoading = true;
        int maxLevels = 2; // Limit depth to prevent overwhelming
        int currentLevel = 0;
        
        try
        {
            while (currentLevel < maxLevels)
            {
                var nodesToExpand = loadedConcepts.Values
                    .Where(n => !n.ChildrenExpanded && n.HasMoreChildren && n.ChildCount > 0)
                    .Take(10) // Limit per level
                    .ToList();

                if (!nodesToExpand.Any()) break;

                foreach (var node in nodesToExpand)
                {
                    await ExpandChildren(node);
                }
                
                currentLevel++;
            }
        }
        finally
        {
            isLoading = false;
        }
    }

    private void AddNode(SnomedNode snomedNode, bool isFocus)
    {
        if (loadedConcepts.ContainsKey(snomedNode.ConceptId)) return;

        snomedNode.IsFocus = isFocus;
        loadedConcepts[snomedNode.ConceptId] = snomedNode;

        var node = new Node()
        {
            ID = snomedNode.ConceptId,
            Width = isFocus ? 200 : 160,
            Height = isFocus ? 70 : 55,
            Shape = new BasicShape() 
            { 
                Type = Syncfusion.Blazor.Diagram.NodeShapes.Basic, 
                Shape = NodeBasicShapes.Rectangle, 
                CornerRadius = isFocus ? 10 : 6 
            },
            Style = new ShapeStyle() 
            { 
                Fill = GetNodeColor(snomedNode), 
                StrokeWidth = isFocus ? 3 : 1, 
                StrokeColor = GetNodeBorderColor(snomedNode)
            },
            Annotations = new DiagramObjectCollection<ShapeAnnotation>()
            {
                new ShapeAnnotation()
                {
                    Content = TruncateText(snomedNode.Term, 30) + (isFocus ? $"\n({snomedNode.ConceptId})" : ""),
                    Style = new TextStyle()
                    {
                        Color = "white",
                        FontSize = isFocus ? 11 : 10,
                        Bold = isFocus,
                        TextWrapping = Syncfusion.Blazor.Diagram.TextWrap.Wrap
                    }
                }
            },
            Data = snomedNode
        };

        // Add expand indicator if has more to show
        if ((snomedNode.HasMoreParents && !snomedNode.ParentsExpanded) || 
            (snomedNode.HasMoreChildren && !snomedNode.ChildrenExpanded))
        {
            node.Annotations.Add(new ShapeAnnotation()
            {
                Content = "●",
                Offset = new DiagramPoint() { X = 1, Y = 0 },
                Style = new TextStyle()
                {
                    Color = "#ffd43b",
                    FontSize = 16,
                    Bold = true
                },
                Margin = new DiagramThickness() { Right = -5, Top = -5 }
            });
        }

        nodes.Add(node);
    }

    private void UpdateNodeAppearance(SnomedNode snomedNode)
    {
        var node = nodes.FirstOrDefault(n => n.ID == snomedNode.ConceptId);
        if (node != null)
        {
            // Remove expand indicator if fully expanded
            if ((!snomedNode.HasMoreParents || snomedNode.ParentsExpanded) && 
                (!snomedNode.HasMoreChildren || snomedNode.ChildrenExpanded))
            {
                while (node.Annotations.Count > 1)
                {
                    node.Annotations.RemoveAt(1);
                }
            }
        }
    }

    private void AddConnector(string childId, string parentId)
    {
        var connectorId = $"{childId}-{parentId}";
        if (connectors.Any(c => c.ID == connectorId)) return;

        connectors.Add(new Connector()
        {
            ID = connectorId,
            SourceID = childId,
            TargetID = parentId,
            Type = ConnectorSegmentType.Orthogonal,
            CornerRadius = 5,
            Style = new ShapeStyle()
            {
                StrokeColor = "#6d6d6d",
                StrokeWidth = 1
            },
            TargetDecorator = new DecoratorSettings()
            {
                Shape = DecoratorShape.Arrow,
                Height = 8,
                Width = 8,
                Style = new ShapeStyle()
                {
                    Fill = "#6d6d6d",
                    StrokeColor = "#6d6d6d"
                }
            }
        });
    }

    private string GetNodeColor(SnomedNode node)
    {
        if (node.IsFocus) return "#ff6b6b";
        if (node.ConceptId == "404684003") return "#e7704c"; // Root
        return node.NodeType switch
        {
            "Parent" => "#4dabf7",
            "Child" => "#69db7c",
            _ => "#868e96"
        };
    }

    private string GetNodeBorderColor(SnomedNode node)
    {
        if (node.IsFocus) return "#c92a2a";
        if (node.ConceptId == "404684003") return "#c15433"; // Root
        return node.NodeType switch
        {
            "Parent" => "#1971c2",
            "Child" => "#2f9e44",
            _ => "#495057"
        };
    }

    private string TruncateText(string text, int maxLength)
    {
        if (string.IsNullOrEmpty(text)) return "";
        return text.Length <= maxLength ? text : text.Substring(0, maxLength - 3) + "...";
    }

    private async Task RefreshLayout()
    {
        if (Diagram != null)
        {
            await Diagram.DoLayoutAsync();
            await Task.Delay(100);
            FitToPage();
        }
    }

    private void FitToPage()
    {
        if (Diagram != null)
        {
            Diagram.FitToPage(new FitOptions() { Mode = FitMode.Both, Region = DiagramRegion.Content });
        }
    }

    private void ToggleOrientation()
    {
        orientation = orientation == LayoutOrientation.TopToBottom 
            ? LayoutOrientation.LeftToRight 
            : LayoutOrientation.TopToBottom;
    }

    private async Task ClearDiagram()
    {
        nodes.Clear();
        connectors.Clear();
        loadedConcepts.Clear();
        selectedNode = null;
        focusConceptName = null;
        focusConceptId = null;
        await Task.CompletedTask;
    }

    private void OnSelectionChanged(Syncfusion.Blazor.Diagram.SelectionChangedEventArgs args)
    {
        try
        {
            selectedNode = null;
            
            if (args?.NewValue?.Count > 0)
            {
                var selectedDiagramNode = args.NewValue.FirstOrDefault() as Node;
                if (selectedDiagramNode?.Data is SnomedNode snomedNode)
                {
                    selectedNode = snomedNode;
                }
            }
        }
        catch
        {
            // Ignore selection errors during initialization
        }
    }

    private async Task OnDiagramClick(Syncfusion.Blazor.Diagram.ClickEventArgs args)
    {
        if (isLoading) return;
        
        try
        {
            // Check if a node was clicked (args.Element can be null for diagram background clicks)
            if (args?.Element is Node clickedNode && clickedNode.Data is SnomedNode snomedNode)
            {
                selectedNode = snomedNode;
                
                // Auto-expand parents if not already expanded
                if (!snomedNode.ParentsExpanded && snomedNode.HasMoreParents)
                {
                    await ExpandParents(snomedNode);
                }
                
                // Auto-expand children if not already expanded
                if (!snomedNode.ChildrenExpanded && snomedNode.HasMoreChildren)
                {
                    await ExpandChildren(snomedNode);
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
    }

    // API call - uses demo data for now, replace with real API call
    private async Task<ConceptData> GetConceptWithRelatives(string conceptId, string direction = "Both")
    {
        // TODO: Replace with actual API call when Azure Function is deployed
        // Example:
        // var response = await Http.GetFromJsonAsync<ConceptData>($"{ApiBaseUrl}snomed-relatives/{conceptId}?direction={direction}");
        // return response ?? new ConceptData();

        await Task.Delay(100); // Simulate network delay

        if (demoData.TryGetValue(conceptId, out var data))
        {
            var result = new ConceptData
            {
                Focus = data.Focus != null ? CloneNode(data.Focus) : null
            };
            
            if (direction == "Both" || direction == "Parents")
            {
                result.Parents = data.Parents.Select(CloneNode).ToList();
            }
            
            if (direction == "Both" || direction == "Children")
            {
                result.Children = data.Children.Select(CloneNode).ToList();
            }
            
            return result;
        }

        return new ConceptData();
    }
    
    private SnomedNode CloneNode(SnomedNode node)
    {
        return new SnomedNode
        {
            ConceptId = node.ConceptId,
            Term = node.Term,
            FSN = node.FSN,
            IsActive = node.IsActive,
            NodeType = node.NodeType,
            HasMoreParents = node.HasMoreParents,
            HasMoreChildren = node.HasMoreChildren,
            ParentCount = node.ParentCount,
            ChildCount = node.ChildCount
        };
    }

    // Data classes
    public class SnomedNode
    {
        public string ConceptId { get; set; } = "";
        public string Term { get; set; } = "";
        public string FSN { get; set; } = "";
        public bool IsActive { get; set; }
        public string NodeType { get; set; } = "Focus";
        public bool IsFocus { get; set; }
        public bool HasMoreParents { get; set; }
        public bool HasMoreChildren { get; set; }
        public bool ParentsExpanded { get; set; }
        public bool ChildrenExpanded { get; set; }
        public int ParentCount { get; set; }
        public int ChildCount { get; set; }
    }

    public class ConceptData
    {
        public SnomedNode? Focus { get; set; }
        public List<SnomedNode> Parents { get; set; } = new();
        public List<SnomedNode> Children { get; set; } = new();
    }
}
