@code {
    private string searchCodes = "";
    private List<SnomedUsageData>? usageResults;
    private bool isLoading = false;
    private bool hasSearched = false;
    private string errorMessage = "";

    public enum ExampleType
    {
        BodyMass,
        CellCount,
        Multiple,
        TopUsed2024
    }

    private async Task SearchUsageData()
    {
        if (isLoading)
        {
            return;
        }

        usageResults = null;
        hasSearched = false;
        errorMessage = "";

        var codes = searchCodes.Split(
            new[] { ',', ';', '\r', '\n', '\t', ' ' },
            StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

        if (codes.Length == 0)
        {
            errorMessage = "Please enter at least one SNOMED CT code.";
            return;
        }

        var invalidCodes = codes.Where(code => code.Any(character => character is < '0' or > '9'))
            .Distinct(StringComparer.Ordinal).ToArray();
        if (invalidCodes.Length > 0)
        {
            errorMessage = $"Invalid SNOMED CT code(s): {string.Join(", ", invalidCodes)}";
            return;
        }

        isLoading = true;

        try
        {
            usageResults = await AzureFunctionService.GetUsageDataAsync(
                string.Join(',', codes.Distinct(StringComparer.Ordinal)));
            hasSearched = true;
        }
        catch (ArgumentException ex)
        {
            errorMessage = ex.Message;
        }
        catch (Exception ex)
        {
            errorMessage = "The usage data could not be loaded. Please try again.";
            usageResults = null;
            Console.WriteLine($"SearchUsageData Error: {ex}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OnSearchCodesInput(TextAreaInputEventArgs args)
    {
        searchCodes = args.Value ?? "";
    }

    private void ClearData()
    {
        searchCodes = "";
        usageResults = null;
        errorMessage = "";
        hasSearched = false;
    }

    private void SetExampleCodes(ExampleType type)
    {
        searchCodes = type switch
        {
            ExampleType.BodyMass => "698065002",
            ExampleType.CellCount => "1022541000000102",
            ExampleType.Multiple => "182836005,88551000000109,93311000000106,1239511000000100,394720003,391156007,279681000000105,413974004,415693003,870661000000100,922731000000106,394725008,413143000,473226007,401062003,712761000000103,287031000000100,803361000000109,938551000000108,858091000000102,769063007,772741000000105,394724007,473225006,810241000000107,381231000000106,381291000000107,381351000000107,1106111000000108,718017007,381261000000101,381321000000102,1079381000000109,1811000124107,965871000000101,473231009,395005007,792951000000100,473223004,1841000124106,753951000000101,473219007,1103191000000105,1089291000000107,473221002,473227003,473235000,473230005,473220001,473228008,428911000124108,473234001,473224005,473233007,473232002,1831000124101,1156698007,6021000124103",
            ExampleType.TopUsed2024 => "279991000000102,184103008,423876004,72313002,1091811000000102,1068881000000101,60621009,1000731000000107,27113001,1000661000000107,1000651000000109,1000821000000103,1022431000000105,1022651000000100,1022541000000102,1022551000000104,1022491000000106,1022581000000105,1022451000000103,1022561000000101,1022471000000107,78564009,313334002,1022591000000107,1022571000000108,163020007,1022291000000105,1000621000000104,1018251000000107,1022441000000101,999791000000106,196411000000103,25721000000107,997531000000108,1101161000000100,1000951000000103,248333004,1022481000000109,1011481000000105,1022791000000101,1005681000000107,997591000000109,717371000000107,266919005,993501000000105,1000811000000109,1005671000000105,185317003,1000971000000107,1015681000000109,1005691000000109,1006191000000106,401271004,182836005,37351000000107,428481002,386472008,183049006,1005661000000103,203031000000107,394837003,1020291000000106,993381000000106,364712009,1001231000000108,1022191000000100,1362591000000103,1484831000000102,1022461000000100,185210004,182771004,1000691000000101,993411000000108,993391000000108,250171008,431314004,314530002,307818003,11429006,25611000000107,283511000000105,8517006,270426007,935051000000108,225323000,281399006,198291000000105,1001371000000100,222711000000102,1023491000000104,14734007,370822003,999691000000104,751481000000104,225390008,182888003,185305000,162999005,993481000000101,77248004",
            _ => ""
        };
    }

    private string GetCellStyle(long value)
    {
        // Color palette based on screenshot
        if (value == -1) return "background-color: #eee8f8; color: #563d7c; border: 1px solid #d4c5eb; padding: 4px; border-radius: 3px;"; // Suppressed 1-4
        if (value == 0) return "background-color: #f8f9fa; color: #6c757d; border: 1px solid #e9ecef; padding: 4px; border-radius: 3px;"; // No Data
        if (value <= 100) return "background-color: #e8f4f8; color: #2c5aa0; border: 1px solid #b8dce8; padding: 4px; border-radius: 3px;"; // Very Low
        if (value <= 1000) return "background-color: #d4f1d4; color: #1e7e34; border: 1px solid #a3d9a3; padding: 4px; border-radius: 3px;"; // Low
        if (value <= 10000) return "background-color: #fff3cd; color: #856404; border: 1px solid #f6e0a6; padding: 4px; border-radius: 3px;"; // Medium
        if (value <= 100000) return "background-color: #f8d7da; color: #721c24; border: 1px solid #f1b0b7; padding: 4px; border-radius: 3px;"; // High
        return "background-color: #f9c6d1; color: #721c24; border: 1px solid #f1b0b7; padding: 4px; border-radius: 3px;"; // Very High
    }

    private string FormatNumber(long value)
    {
        return value == -1 ? "*" : value.ToString("N0", CultureInfo.CurrentCulture);
    }

    private async Task ExportToCsv()
    {
        if (usageResults == null || !usageResults.Any())
            return;

        try
        {
            var csvContent = new StringBuilder();
            csvContent.AppendLine("SNOMED CT Code,Procedure,Geographic Coverage,2024-25,2023-24,2022-23,2021-22,2020-21,2019-20,2018-19,2017-18,2016-17,2015-16,2014-15,2013-14,2012-13,2011-12");
            
            foreach (var item in usageResults)
            {
                csvContent.Append(EscapeCsv(item.ConceptId)).Append(',')
                    .Append(EscapeCsv(item.Procedure)).Append(',')
                    .Append(EscapeCsv(item.GeographicCoverage));

                var values = new[]
                {
                    item.Usage_2024_25, item.Usage_2023_24, item.Usage_2022_23, item.Usage_2021_22,
                    item.Usage_2020_21, item.Usage_2019_20, item.Usage_2018_19, item.Usage_2017_18,
                    item.Usage_2016_17, item.Usage_2015_16, item.Usage_2014_15, item.Usage_2013_14,
                    item.Usage_2012_13, item.Usage_2011_12
                };
                foreach (var value in values)
                {
                    csvContent.Append(',').Append(value == -1 ? "*" : value.ToString(CultureInfo.InvariantCulture));
                }
                csvContent.AppendLine();
            }

            await JSRuntime.InvokeVoidAsync("downloadFile", "snomed-usage-data.csv", csvContent.ToString(), "text/csv");
        }
        catch (Exception ex)
        {
            errorMessage = $"Export failed: {ex.Message}";
        }
    }

    private static string EscapeCsv(string? value)
    {
        return "\"" + (value ?? string.Empty).Replace("\"", "\"\"") + "\"";
    }
}

