@page "/usage-viewer-syncfusion"
@inject AzureFunctionService AzureFunctionService
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

@using System.Globalization
@using System.Text

@using Syncfusion.Blazor
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.Inputs
@using Syncfusion.Blazor.Popups

<PageTitle>Primary Care SNOMED CT Usage Data Viewer - Syncfusion</PageTitle>

<!-- Page Header Section - positioned to align with sidebar -->
<div class="page-header-wrapper">
    <div class="page-header">        <div class="page-header-content">
            <div class="page-header-main">
                <h4 class="page-title mb-1">Primary Care SNOMED CT Usage Data Viewer</h4>
                <p class="page-subtitle mb-0">Query SNOMED CT concept usage statistics from 2011-12 through 2025-26 (NHS England Data)</p>
            </div>            <div class="page-header-actions">
                <span class="created-by">Created by Imran Khan</span>
                <a href="https://github.com" target="_blank" class="github-link">
                    <i class="fab fa-github fa-lg"></i>
                </a>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid usage-viewer"><!-- Search Section -->
    <p class="small text-muted mb-2">
        Latest release: <a href="https://digital.nhs.uk/data-and-information/publications/statistical/mi-snomed-code-usage-in-primary-care/2025-26" target="_blank" rel="noopener noreferrer">2025-26</a>, covering 1 August 2025 to 31 July 2026 (England).
    </p>
    <div class="content-section">
        <div class="row mb-3">
            <div class="col-12">
                <div class="card usage-search-card">                    <div class="card-body">
                        <div class="row align-items-start">
                            <div class="col-md-8">
                                <label for="usage-concept-search" class="form-label fw-bold mb-1">Search by SNOMED CT code or term</label>
                                <div class="usage-concept-search">
                                    <input id="usage-concept-search" @ref="conceptSearchInput" class="form-control"
                                           value="@conceptQuery" @oninput="OnConceptQueryInput" @onkeydown="OnConceptQueryKeyDown"
                                           @onfocus="OnConceptQueryFocus" @onblur="DismissSuggestions"
                                           disabled="@isLoading" maxlength="100" autocomplete="off" spellcheck="false"
                                           placeholder="Start typing a code or term, e.g. acid reflux"
                                           role="combobox" aria-autocomplete="list" aria-haspopup="listbox"
                                           aria-expanded="@(suggestions.Count > 0 ? "true" : "false")"
                                           aria-controls="usage-concept-suggestions" aria-activedescendant="@ActiveSuggestionId"
                                           aria-describedby="usage-concept-help usage-concept-status" />
                                    @if (suggestions.Count > 0)
                                    {
                                        <ul id="usage-concept-suggestions" class="usage-suggestions" role="listbox" aria-label="SNOMED CT concepts in the usage dataset">
                                            @for (var index = 0; index < suggestions.Count; index++)
                                            {
                                                var suggestionIndex = index;
                                                var suggestion = suggestions[index];
                                                <li id="usage-suggestion-@index" role="option"
                                                    aria-selected="@(activeSuggestionIndex == index ? "true" : "false")"
                                                    class="usage-suggestion @(activeSuggestionIndex == index ? "active" : "")"
                                                    title="@suggestion.Description"
                                                    @onpointerdown="KeepSearchFocus" @onpointerdown:preventDefault="true"
                                                    @onmousedown="KeepSearchFocus" @onmousedown:preventDefault="true"
                                                    @onclick="() => SelectSuggestion(suggestionIndex)">
                                                    <span class="usage-suggestion-description">@suggestion.Description</span>
                                                    <span class="usage-suggestion-code">@suggestion.ConceptId</span>
                                                </li>
                                            }
                                        </ul>
                                    }
                                </div>
                                <small id="usage-concept-help" class="form-text text-muted d-block">
                                    Type 3+ characters; select a concept, then SEARCH.
                                    <span class="text-nowrap">↑/↓ browse · Enter select · Esc close.</span>
                                </small>
                                <div id="usage-concept-status" class="small text-muted mt-1" role="status" aria-live="polite">
                                    @(isLoadingSuggestions ? "Finding matching concepts…" : suggestionMessage)
                                </div>
                                <label for="snomedCodes" class="form-label fw-bold mt-2 mb-1">SNOMED CT codes to compare</label>
                                <textarea id="snomedCodes" class="form-control snomed-textarea" rows="1"
                                          @bind="searchCodes" @bind:event="oninput" disabled="@isLoading"
                                          placeholder="Enter SNOMED CT codes"
                                          aria-describedby="usage-codes-help"></textarea>
                                <small id="usage-codes-help" class="form-text text-muted">Add several concepts or paste multiple codes separated by commas.</small>
                            </div>
                            <div class="col-md-4 usage-templates">
                                <!-- Quick search templates -->
                                <div class="mb-2">
                                    <div class="d-flex align-items-center gap-2 mb-1">
                                        <span class="fw-bold text-muted">Quick Search Templates:</span>
                                        <SfTooltip Target="#template-info-icon" 
                                                  Content="Click any template below to populate the search field with codes, then click SEARCH to view usage data."
                                                  Position="Position.BottomCenter">
                                            <i id="template-info-icon" class="fas fa-info-circle text-muted" style="font-size: 0.9rem; cursor: help;"></i>
                                        </SfTooltip>
                                    </div>
                                    <div class="d-flex flex-column" style="gap: 0.15rem;">
                                        <SfButton @onclick="() => SetExampleCodes(ExampleType.TopUsed2025)"
                                                 CssClass="e-link e-small text-start">
                                            Most commonly used SNOMED codes 2025-26 (100 codes)
                                        </SfButton>
                                        <SfButton @onclick="() => SetExampleCodes(ExampleType.Multiple)" 
                                                 CssClass="e-link e-small text-start">
                                            Multiple codes
                                        </SfButton>
                                        <SfButton @onclick="() => SetExampleCodes(ExampleType.BodyMass)" 
                                                 CssClass="e-link e-small text-start">
                                            698065002 |Acid reflux (finding)|
                                        </SfButton>
                                        <SfButton @onclick="() => SetExampleCodes(ExampleType.CellCount)" 
                                                 CssClass="e-link e-small text-start">
                                            1022541000000102 |Total white cell count (observable entity)|
                                        </SfButton>
                                    </div>
                                </div>
                                <!-- Search buttons moved below examples -->
                                <div class="d-flex gap-2 mt-2">
                                    <SfButton @onclick="SearchUsageData" 
                                             Disabled="@isLoading"
                                             CssClass="e-primary">
                                        @if (isLoading)
                                        {
                                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                        }
                                        SEARCH
                                    </SfButton>
                                    <SfButton @onclick="ClearData" 
                                             Disabled="@isLoading"
                                             CssClass="e-outline">
                                        CLEAR
                                    </SfButton>
                                </div>
                            </div>
                        </div>
                    </div>
            </div>
        </div>
    </div>

    <!-- Usage Scale Legend -->
    @if (usageResults != null && usageResults.Any())
    {
        <div class="row mb-2">
            <div class="col-12">
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <span class="fw-bold">Usage Scale:</span>
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <span class="badge" style="background-color: #e8f4f8; color: #2c5aa0; border: 1px solid #b8dce8;">Very Low (1-100)</span>
                        <span class="badge" style="background-color: #d4f1d4; color: #1e7e34; border: 1px solid #a3d9a3;">Low (101-1,000)</span>
                        <span class="badge" style="background-color: #fff3cd; color: #856404; border: 1px solid #f6e0a6;">Medium (1,001-10,000)</span>
                        <span class="badge" style="background-color: #f8d7da; color: #721c24; border: 1px solid #f1b0b7;">High (10,001-100,000)</span>
                        <span class="badge" style="background-color: #f9c6d1; color: #721c24; border: 1px solid #f1b0b7;">Very High (100,001+)</span>
                        <span class="badge" style="background-color: #eee8f8; color: #563d7c; border: 1px solid #d4c5eb;">Suppressed (1-4)</span>
                        <span class="badge bg-light text-muted border">No Data</span>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Error Display -->
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>
            <strong>Error:</strong> @errorMessage
        </div>
    }    <!-- Results Section with Syncfusion Grid -->
    @if (usageResults != null && usageResults.Any())
    {
        <div class="row">
            <div class="col-12">
                <div class="card usage-results">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <span class="fw-bold">Results: @usageResults.Count result(s) found</span>
                        <SfButton @onclick="ExportToCsv" 
                                 CssClass="e-outline e-small">
                            <i class="fas fa-download me-1"></i>Export CSV
                        </SfButton>
                    </div>
                    <div class="card-body p-0">                        @try
                        {
                            @if (usageResults != null && usageResults.Count > 0)
                            {
                                <div class="table-responsive">
                                    <table class="table table-striped table-hover">
                                        <thead class="table-dark">
                                            <tr>
                                                <th>SNOMED CT Code</th>
                                                <th>Procedure Description</th>
                                                <th>2025-26</th>
                                                <th>2024-25</th>
                                                <th>2023-24</th>
                                                <th>2022-23</th>
                                                <th>2021-22</th>
                                                <th>2020-21</th>
                                                <th>2019-20</th>
                                                <th>2018-19</th>
                                                <th>2017-18</th>
                                                <th>2016-17</th>
                                                <th>2015-16</th>
                                                <th>2014-15</th>
                                                <th>2013-14</th>
                                                <th>2012-13</th>
                                                <th>2011-12</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in usageResults)
                                            {
                                                <tr>
                                                    <td><strong>@item.ConceptId</strong> <span class="text-muted small">(@item.GeographicCoverage)</span></td>
                                                    <td><span class="procedure-description">@item.Procedure</span></td>
                                                    <td><span style="@GetCellStyle(item.Usage_2025_26)" class="usage-cell">@FormatNumber(item.Usage_2025_26)</span></td>
                                                    <td><span style="@GetCellStyle(item.Usage_2024_25)" class="usage-cell">@FormatNumber(item.Usage_2024_25)</span></td>
                                                    <td><span style="@GetCellStyle(item.Usage_2023_24)" class="usage-cell">@FormatNumber(item.Usage_2023_24)</span></td>
                                                    <td><span style="@GetCellStyle(item.Usage_2022_23)" class="usage-cell">@FormatNumber(item.Usage_2022_23)</span></td>
                                                    <td><span style="@GetCellStyle(item.Usage_2021_22)" class="usage-cell">@FormatNumber(item.Usage_2021_22)</span></td>
                                                    <td><span style="@GetCellStyle(item.Usage_2020_21)" class="usage-cell">@FormatNumber(item.Usage_2020_21)</span></td>
                                                    <td><span style="@GetCellStyle(item.Usage_2019_20)" class="usage-cell">@FormatNumber(item.Usage_2019_20)</span></td>
                                                    <td><span style="@GetCellStyle(item.Usage_2018_19)" class="usage-cell">@FormatNumber(item.Usage_2018_19)</span></td>
                                                    <td><span style="@GetCellStyle(item.Usage_2017_18)" class="usage-cell">@FormatNumber(item.Usage_2017_18)</span></td>
                                                    <td><span style="@GetCellStyle(item.Usage_2016_17)" class="usage-cell">@FormatNumber(item.Usage_2016_17)</span></td>
                                                    <td><span style="@GetCellStyle(item.Usage_2015_16)" class="usage-cell">@FormatNumber(item.Usage_2015_16)</span></td>
                                                    <td><span style="@GetCellStyle(item.Usage_2014_15)" class="usage-cell">@FormatNumber(item.Usage_2014_15)</span></td>
                                                    <td><span style="@GetCellStyle(item.Usage_2013_14)" class="usage-cell">@FormatNumber(item.Usage_2013_14)</span></td>
                                                    <td><span style="@GetCellStyle(item.Usage_2012_13)" class="usage-cell">@FormatNumber(item.Usage_2012_13)</span></td>
                                                    <td><span style="@GetCellStyle(item.Usage_2011_12)" class="usage-cell">@FormatNumber(item.Usage_2011_12)</span></td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-info">No data to display</div>
                            }
                        }
                        catch (Exception ex)
                        {
                            <div class="alert alert-danger">
                                <strong>Grid Error:</strong> @ex.Message
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }    else if (hasSearched && !isLoading && string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-info">
            <i class="fas fa-info-circle me-2"></i>
            No usage data found for the provided SNOMED CT codes. Please verify the codes and try again.
        </div>
    }
    </div>
</div>

