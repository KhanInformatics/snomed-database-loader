    private string GetCellStyle(long value)
    {
        // Color palette based on screenshot
        if (value == -1) return "background-color: #eee8f8; color: #563d7c; border: 1px solid #d4c5eb; padding: 4px; border-radius: 3px;"; // Suppressed 1-4
        if (value == 0) return "background-color: #f8f9fa; color: #6c757d; border: 1px solid #e9ecef; padding: 4px; border-radius: 3px;"; // No Data
        if (value <= 100) return "background-color: #e8f4f8; color: #2c5aa0; border: 1px solid #b8dce8; padding: 4px; border-radius: 3px;"; // Very Low
        if (value <= 1000) return "background-color: #d4f1d4; color: #1e7e34; border: 1px solid #a3d9a3; padding: 4px; border-radius: 3px;"; // Low
        if (value <= 10000) return "background-color: #fff3cd; color: #856404; border: 1px solid #f6e0a6; padding: 4px; border-radius: 3px;"; // Medium
        if (value <= 100000) return "background-color: #f8d7da; color: #721c24; border: 1px solid #f1b0b7; padding: 4px; border-radius: 3px;"; // High
        return "background-color: #f9c6d1; color: #721c24; border: 1px solid #f1b0b7; padding: 4px; border-radius: 3px;"; // Very High
    }

    private string FormatNumber(long value)
    {
        return value == -1 ? "*" : value.ToString("N0", CultureInfo.CurrentCulture);
    }

    private async Task ExportToCsv()
    {
        if (usageResults == null || !usageResults.Any())
            return;

        try
        {
            var csvContent = new StringBuilder();
            csvContent.AppendLine("SNOMED CT Code,Procedure,Geographic Coverage,2025-26,2024-25,2023-24,2022-23,2021-22,2020-21,2019-20,2018-19,2017-18,2016-17,2015-16,2014-15,2013-14,2012-13,2011-12");
            foreach (var item in usageResults)
            {
                csvContent.Append(EscapeCsv(item.ConceptId)).Append(',')
                    .Append(EscapeCsv(item.Procedure)).Append(',')
                    .Append(EscapeCsv(item.GeographicCoverage));

                var values = new[]
                {
                    item.Usage_2025_26,
                    item.Usage_2024_25, item.Usage_2023_24, item.Usage_2022_23, item.Usage_2021_22,
                    item.Usage_2020_21, item.Usage_2019_20, item.Usage_2018_19, item.Usage_2017_18,
                    item.Usage_2016_17, item.Usage_2015_16, item.Usage_2014_15, item.Usage_2013_14,
                    item.Usage_2012_13, item.Usage_2011_12
                };
                foreach (var value in values)
                {
                    csvContent.Append(',').Append(value == -1 ? "*" : value.ToString(CultureInfo.InvariantCulture));
                }
                csvContent.AppendLine();
            }

            await JSRuntime.InvokeVoidAsync("downloadFile", "snomed-usage-data.csv", csvContent.ToString(), "text/csv");
        }
        catch (Exception ex)
        {
            errorMessage = $"Export failed: {ex.Message}";
        }
    }

    private static string EscapeCsv(string? value)
    {
        return "\"" + (value ?? string.Empty).Replace("\"", "\"\"") + "\"";
    }

    public async ValueTask DisposeAsync()
    {
        disposed = true;
        DismissSuggestions();
        if (searchModule != null)
        {
            await searchModule.InvokeVoidAsync("detach", conceptSearchInput);
            await searchModule.DisposeAsync();
        }
    }
