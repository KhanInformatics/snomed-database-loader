@code {
    private string searchCodes = "";
    private List<SnomedUsageData>? usageResults;
    private bool isLoading = false;
    private bool hasSearched = false;
    private string errorMessage = "";
    private string conceptQuery = "";
    private List<SnomedUsageSuggestion> suggestions = new();
    private int activeSuggestionIndex = -1;
    private bool isLoadingSuggestions;
    private string suggestionMessage = "";
    private CancellationTokenSource? suggestionCancellation;
    private ElementReference conceptSearchInput;
    private IJSObjectReference? searchModule;
    private bool scrollActiveSuggestion;
    private bool disposed;
    private string? ActiveSuggestionId => activeSuggestionIndex >= 0 ? $"usage-suggestion-{activeSuggestionIndex}" : null;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            searchModule = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/usageSearch.js");
            if (disposed)
            {
                await searchModule.DisposeAsync();
                return;
            }
            await searchModule.InvokeVoidAsync("attach", conceptSearchInput);
        }
        if (scrollActiveSuggestion && searchModule != null)
        {
            scrollActiveSuggestion = false;
            await searchModule.InvokeVoidAsync("scrollToOption", ActiveSuggestionId);
        }
    }

    private async Task OnConceptQueryInput(Microsoft.AspNetCore.Components.ChangeEventArgs args)
    {
        conceptQuery = args.Value?.ToString() ?? "";
        await LoadSuggestions();
    }

    private Task OnConceptQueryFocus() => LoadSuggestions();

    private async Task LoadSuggestions()
    {
        DismissSuggestions();
        var query = conceptQuery.Trim();
        if (query.Length < 3 || disposed || isLoading)
        {
            return;
        }

        using var cancellation = new CancellationTokenSource();
        suggestionCancellation = cancellation;
        var token = cancellation.Token;
        isLoadingSuggestions = true;
        try
        {
            await Task.Delay(300, token);
            var matches = await AzureFunctionService.GetUsageSuggestionsAsync(query, token);
            if (!token.IsCancellationRequested && !disposed)
            {
                suggestions = matches;
                suggestionMessage = matches.Count == 0
                    ? "No matching concepts in the usage dataset. Try another term or enter a code below."
                    : $"{matches.Count} suggestions. Select a concept to add its code.";
            }
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested)
        {
            // A newer query, selection, blur or navigation superseded this request.
        }
        catch (Exception)
        {
            if (!token.IsCancellationRequested && !disposed)
            {
                suggestionMessage = "Suggestions are temporarily unavailable. You can still enter SNOMED CT codes below.";
            }
        }
        finally
        {
            if (ReferenceEquals(suggestionCancellation, cancellation))
            {
                suggestionCancellation = null;
                isLoadingSuggestions = false;
            }
        }
    }

    private void DismissSuggestions()
    {
        suggestionCancellation?.Cancel();
        suggestionCancellation = null;
        suggestions.Clear();
        activeSuggestionIndex = -1;
        isLoadingSuggestions = false;
        suggestionMessage = "";
    }

    private async Task OnConceptQueryKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            DismissSuggestions();
        }
        else if (args.Key is "ArrowDown" or "ArrowUp")
        {
            if (suggestions.Count == 0)
            {
                await LoadSuggestions();
            }
            if (suggestions.Count > 0)
            {
                activeSuggestionIndex = args.Key == "ArrowDown"
                    ? (activeSuggestionIndex + 1) % suggestions.Count
                    : (activeSuggestionIndex <= 0 ? suggestions.Count - 1 : activeSuggestionIndex - 1);
                scrollActiveSuggestion = true;
            }
        }
        else if (args.Key == "Enter")
        {
            if (activeSuggestionIndex >= 0)
            {
                SelectSuggestion(activeSuggestionIndex);
            }
            else if (IsCompleteCode(conceptQuery.Trim()))
            {
                AddConceptCode(conceptQuery.Trim());
            }
            else if (suggestions.Count > 0)
            {
                activeSuggestionIndex = 0;
                scrollActiveSuggestion = true;
                suggestionMessage = "Press Enter to add the highlighted concept, or use the arrow keys to choose another.";
            }
        }
    }

    private static bool IsCompleteCode(string value) => value.Length is >= 6 and <= 18
        && value.All(character => character is >= '0' and <= '9');

    private void SelectSuggestion(int index)
    {
        if (index >= 0 && index < suggestions.Count)
        {
            AddConceptCode(suggestions[index].ConceptId);
        }
    }

    private void KeepSearchFocus() { }

    private void AddConceptCode(string code)
    {
        var codes = searchCodes.Split(new[] { ',', ';', '\r', '\n', '\t', ' ' },
            StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        var alreadyAdded = codes.Contains(code, StringComparer.Ordinal);
        searchCodes = string.Join(", ", codes.Append(code).Distinct(StringComparer.Ordinal));
        conceptQuery = "";
        DismissSuggestions();
        suggestionMessage = alreadyAdded ? $"{code} is already in the list." : $"Added {code}. Add another concept or click SEARCH.";
        errorMessage = "";
    }

    public enum ExampleType
    {
        BodyMass,
        CellCount,
        Multiple,
        TopUsed2025
    }

    private async Task SearchUsageData()
    {
        if (isLoading)
        {
            return;
        }

        if (!string.IsNullOrWhiteSpace(conceptQuery))
        {
            if (!IsCompleteCode(conceptQuery.Trim()))
            {
                errorMessage = "Select a suggested concept, or enter a complete SNOMED CT code before searching.";
                return;
            }
            AddConceptCode(conceptQuery.Trim());
        }
        DismissSuggestions();

        usageResults = null;
        hasSearched = false;
        errorMessage = "";

        var codes = searchCodes.Split(
            new[] { ',', ';', '\r', '\n', '\t', ' ' },
            StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

        if (codes.Length == 0)
        {
            errorMessage = "Please enter at least one SNOMED CT code.";
            return;
        }

        var invalidCodes = codes.Where(code => code.Any(character => character is < '0' or > '9'))
            .Distinct(StringComparer.Ordinal).ToArray();
        if (invalidCodes.Length > 0)
        {
            errorMessage = $"Invalid SNOMED CT code(s): {string.Join(", ", invalidCodes)}";
            return;
        }

        isLoading = true;

        try
        {
            usageResults = await AzureFunctionService.GetUsageDataAsync(
                string.Join(',', codes.Distinct(StringComparer.Ordinal)));
            hasSearched = true;
        }
        catch (ArgumentException ex)
        {
            errorMessage = ex.Message;
        }
        catch (Exception ex)
        {
            errorMessage = "The usage data could not be loaded. Please try again.";
            usageResults = null;
            Console.WriteLine($"SearchUsageData Error: {ex}");
        }
        finally
        {
            isLoading = false;
        }
    }

